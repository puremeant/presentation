RUN_SETTING = "avg_val"


if RUN_SETTING == "single_no_val":
    # Single-model, no-validation setting
    USE_ENSEMBLE = False
    N_MC = 1
    N_AVG = 1
    VALIDATION_SPLIT = 0.0
    EARLY_STOP_MONITOR = "loss"

elif RUN_SETTING == "avg_val":
    # Feasible validation-based model averaging setting
    USE_ENSEMBLE = True
    N_MC = 20       # increase to 50 or 100 if time allows
    N_AVG = 5       # increase to 10 if time allows
    VALIDATION_SPLIT = 0.15
    EARLY_STOP_MONITOR = "val_loss"

else:
    raise ValueError("RUN_SETTING must be either 'single_no_val' or 'avg_val'.")


# ==================================================
# 0-2. Forecast and model settings
# ==================================================

OOS_START_DATE = 1989.01
OOS_END_DATE = 2017.12

HYPER_FREQ = 4 * 12

NN_PARAMS = {
    'Dropout': [0.1, 0.3, 0.5],
    'l1l2': [0.01, 0.001]
}

# NN - 1 layer, 3 nodes
hidden_nodes = 3

# NN - 1 layer, 7 nodes로 돌리고 싶으면 위 줄 대신 아래 줄 사용
# hidden_nodes = 7

EPOCHS = 500
BATCH_SIZE = 32
PATIENCE = 20


# ==================================================
# 1. OOS R2 and p-value functions
# ==================================================

def r2_oos(y_true, y_pred, y_hist_mean):
    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()
    return 1 - (numerator / denominator)


def rsz_signif(y_true, y_forecast, y_hist_mean):
    f = ((y_true - y_hist_mean) ** 2
         - (y_true - y_forecast) ** 2
         + (y_hist_mean - y_forecast) ** 2)

    x = np.ones(np.shape(f))

    model = sm.OLS(f, x, missing='drop', hasconst=True)
    results = model.fit(cov_type='HAC', cov_kwds={'maxlags': 12})

    return 1 - tstat.cdf(results.tvalues[0], results.nobs - 1)


# ==================================================
# 2. Build NN
# ==================================================

def build_nn(input_dim, hidden_nodes, output_dim, dropout_rate, penalty, seed):
    np.random.seed(seed)
    keras.utils.set_random_seed(seed)

    model = keras.Sequential([
        layers.Input(shape=(input_dim,)),

        layers.Dropout(dropout_rate),

        layers.Dense(
            hidden_nodes,
            activation='relu',
            kernel_initializer='he_normal',
            bias_initializer='he_normal',
            kernel_regularizer=regularizers.l1_l2(l1=penalty, l2=penalty)
        ),

        layers.Dense(
            output_dim,
            activation='linear',
            kernel_initializer='he_normal',
            bias_initializer='he_normal'
        )
    ])

    lr_schedule = keras.optimizers.schedules.InverseTimeDecay(
        initial_learning_rate=0.01,
        decay_steps=1,
        decay_rate=0.01
    )

    optimizer = keras.optimizers.SGD(
        learning_rate=lr_schedule,
        momentum=0.9,
        nesterov=True
    )

    model.compile(
        optimizer=optimizer,
        loss='mse'
    )

    return model


# ==================================================
# 3. Fit one NN with given hyperparameters
# ==================================================

def fit_one_nn(x_train_scaled, y_train_scaled, x_test_scaled,
               hidden_nodes, seed, dropout_rate, penalty):

    keras.backend.clear_session()

    nn_model = build_nn(
        input_dim=x_train_scaled.shape[1],
        hidden_nodes=hidden_nodes,
        output_dim=y_train_scaled.shape[1],
        dropout_rate=dropout_rate,
        penalty=penalty,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor=EARLY_STOP_MONITOR,
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=1,
        mode='auto',
        restore_best_weights=True
    )

    history = nn_model.fit(
        x_train_scaled,
        y_train_scaled,
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=VALIDATION_SPLIT,
        shuffle=True,
        verbose=0,
        callbacks=[early_stop]
    )

    # If no validation, use training loss.
    # If validation exists, use validation loss.
    model_loss = min(history.history[EARLY_STOP_MONITOR])

    pred_scaled = nn_model.predict(x_test_scaled, verbose=0)

    del nn_model
    keras.backend.clear_session()
    gc.collect()

    return pred_scaled, model_loss


# ==================================================
# 4. Hyperparameter search for one seed
# ==================================================

def grid_search_one_seed(x_train_scaled, y_train_scaled, x_test_scaled,
                         hidden_nodes, seed):

    best_model_loss = np.inf
    best_pred_scaled = None
    best_dropout = None
    best_penalty = None

    for dropout_rate in NN_PARAMS['Dropout']:
        for penalty in NN_PARAMS['l1l2']:

            pred_scaled, model_loss = fit_one_nn(
                x_train_scaled=x_train_scaled,
                y_train_scaled=y_train_scaled,
                x_test_scaled=x_test_scaled,
                hidden_nodes=hidden_nodes,
                seed=seed,
                dropout_rate=dropout_rate,
                penalty=penalty
            )

            if model_loss < best_model_loss:
                best_model_loss = model_loss
                best_pred_scaled = pred_scaled
                best_dropout = dropout_rate
                best_penalty = penalty

    return best_pred_scaled, best_model_loss, best_dropout, best_penalty


# ==================================================
# 5. Load data
# ==================================================

# ---------- PyCharm version ----------
df = pd.read_csv('../DATA/data_soo.csv')

# ---------- Colab version ----------
# file_id = "1GzbqOY80SOjQ7_WE79GYq64Eyq9vKUM4"
# url = f"https://drive.google.com/uc?id={file_id}"
# df = pd.read_csv(url)


x_columns = ['0f1', '1f1', '2f1', '3f1', '4f1',
             '5f1', '6f1', '7f1', '8f1', '9f1']

y_columns = ['xr24', 'xr36', 'xr48', 'xr60', 'xr84', 'xr120']

df_sort = df.copy().sort_values("date").reset_index(drop=True)
df_sort["date"] = df_sort["date"].round(2)

# Keep only rows where X exists
df_sort = df_sort.dropna(subset=x_columns).reset_index(drop=True)

dates = df_sort["date"]

if OOS_START_DATE not in set(dates):
    raise ValueError(f"OOS_START_DATE {OOS_START_DATE} not found in data.")

date_idx = df_sort[df_sort["date"] == OOS_START_DATE].index[0]


# ==================================================
# 6. Recursive OOS forecasting
# ==================================================

saved_dropout = {}
saved_penalty = {}

for step_no, t in enumerate(dates.iloc[date_idx:], start=1):

    if t > OOS_END_DATE:
        continue

    date_str = f"{t:.2f}".replace(".", "_")

    result_file = (
        f"{SAVE_DIR}/result_"
        f"{RUN_SETTING}_"
        f"{hidden_nodes}nodes_"
        f"mc{N_MC}_avg{N_AVG}_"
        f"{date_str}.csv"
    )

    # 이미 저장된 날짜면 건너뛰기
    if os.path.exists(result_file):
        print("Already done, skip:", t)
        continue

    print("Forecasting date:", t)

    # 저자식: 첫 번째 OOS date 또는 48개월마다 hyperparameter search
    if (step_no == 1) or (step_no % HYPER_FREQ == 0):
        refit = True
    else:
        refit = False

    print("  Refit hyperparameters:", refit)

    train = df_sort[df_sort["date"] < t].copy()
    test = df_sort[df_sort["date"] == t].copy()

    if test.empty:
        print("  No test observation for date:", t)
        continue

    if test[y_columns].isna().any(axis=None):
        print("  Missing target for date, skip:", t)
        continue

    x_train = train[x_columns]
    y_train = train[y_columns].dropna()

    # Align x_train and y_train after dropping missing y rows
    valid_train_index = y_train.index
    x_train = x_train.loc[valid_train_index]

    x_test = test[x_columns]
    y_test = test[y_columns]

    y_train_hist_mean = y_train.mean().values

    # Scale X using train only
    x_scaler = StandardScaler()
    x_train_scaled = x_scaler.fit_transform(x_train)
    x_test_scaled = x_scaler.transform(x_test)

    # Scale Y using train only
    y_scaler = StandardScaler()
    y_train_scaled = y_scaler.fit_transform(y_train)

    pred_candidates = []
    loss_candidates = []

    for seed in range(N_MC):
        print("  NN seed:", seed)

        if refit or (seed not in saved_dropout):

            pred_scaled, model_loss, best_dropout, best_penalty = grid_search_one_seed(
                x_train_scaled=x_train_scaled,
                y_train_scaled=y_train_scaled,
                x_test_scaled=x_test_scaled,
                hidden_nodes=hidden_nodes,
                seed=seed
            )

            saved_dropout[seed] = best_dropout
            saved_penalty[seed] = best_penalty

            print("    Best params:",
                  "dropout =", best_dropout,
                  "penalty =", best_penalty)

        else:
            best_dropout = saved_dropout[seed]
            best_penalty = saved_penalty[seed]

            pred_scaled, model_loss = fit_one_nn(
                x_train_scaled=x_train_scaled,
                y_train_scaled=y_train_scaled,
                x_test_scaled=x_test_scaled,
                hidden_nodes=hidden_nodes,
                seed=seed,
                dropout_rate=best_dropout,
                penalty=best_penalty
            )

            print("    Reused params:",
                  "dropout =", best_dropout,
                  "penalty =", best_penalty)

        pred_candidates.append(pred_scaled[0])
        loss_candidates.append(model_loss)

    pred_candidates = np.array(pred_candidates)
    loss_candidates = np.array(loss_candidates)

    # loss가 낮은 top N_AVG개 고르기
    top_idx = np.argsort(loss_candidates)[:N_AVG]

    print("  Top model indices:", top_idx)
    print(f"  Top {EARLY_STOP_MONITOR} losses:", loss_candidates[top_idx])
    print(f"  Best {EARLY_STOP_MONITOR} loss:", loss_candidates[top_idx[0]])

    # top models의 scaled prediction 평균
    pred_scaled_avg = pred_candidates[top_idx].mean(axis=0).reshape(1, -1)

    # 원래 excess return 단위로 되돌리기
    y_pred = y_scaler.inverse_transform(pred_scaled_avg)

    # 이 날짜 결과만 저장
    one_result = pd.DataFrame({'date': [t]})

    for i, y in enumerate(y_columns):
        one_result[f'pred_{y}'] = y_pred[0, i]
        one_result[f'true_{y}'] = y_test.iloc[0].values[i]
        one_result[f'hist_{y}'] = y_train_hist_mean[i]

    one_result["RUN_SETTING"] = RUN_SETTING
    one_result["N_MC"] = N_MC
    one_result["N_AVG"] = N_AVG
    one_result["VALIDATION_SPLIT"] = VALIDATION_SPLIT
    one_result["EARLY_STOP_MONITOR"] = EARLY_STOP_MONITOR
    one_result["HIDDEN_NODES"] = hidden_nodes
    one_result["best_loss"] = loss_candidates[top_idx[0]]
    one_result["avg_top_loss"] = loss_candidates[top_idx].mean()

    one_result.to_csv(result_file, index=False)

    print("Saved:", result_file)


# ==================================================
# 7. Load saved results
# ==================================================

pattern = (
    f"{SAVE_DIR}/result_"
    f"{RUN_SETTING}_"
    f"{hidden_nodes}nodes_"
    f"mc{N_MC}_avg{N_AVG}_"
    f"*.csv"
)

files = sorted(glob.glob(pattern))

if len(files) == 0:
    raise ValueError("No saved result files found.")

df_out = pd.concat(
    [pd.read_csv(f) for f in files],
    axis=0,
    ignore_index=True
)

df_out = df_out.sort_values("date").reset_index(drop=True)

df_out_eval = df_out[
    (df_out["date"] >= OOS_START_DATE)
    & (df_out["date"] <= OOS_END_DATE)
].copy()


# ==================================================
# 8. Compute R2 OOS and p-value
# ==================================================

r2_score_list = []
p_value_list = []

for y in y_columns:
    r2_score = r2_oos(
        df_out_eval[f'true_{y}'],
        df_out_eval[f'pred_{y}'],
        df_out_eval[f'hist_{y}']
    )

    p_value = rsz_signif(
        df_out_eval[f'true_{y}'],
        df_out_eval[f'pred_{y}'],
        df_out_eval[f'hist_{y}']
    )

    r2_score_list.append(r2_score)
    p_value_list.append(p_value)

df_score = pd.DataFrame(
    [r2_score_list, p_value_list],
    index=['R2_oos', 'p_value'],
    columns=y_columns
)


# ==================================================
# 9. Save final results
# ==================================================

pred_all_path = (
    f"{SAVE_DIR}/nn_1layer_{hidden_nodes}nodes_"
    f"{RUN_SETTING}_mc{N_MC}_avg{N_AVG}_predictions_all.csv"
)

pred_eval_path = (
    f"{SAVE_DIR}/nn_1layer_{hidden_nodes}nodes_"
    f"{RUN_SETTING}_mc{N_MC}_avg{N_AVG}_predictions_eval.csv"
)

score_path = (
    f"{SAVE_DIR}/nn_1layer_{hidden_nodes}nodes_"
    f"{RUN_SETTING}_mc{N_MC}_avg{N_AVG}_score_eval.csv"
)

df_out.to_csv(pred_all_path, index=False)
df_out_eval.to_csv(pred_eval_path, index=False)
df_score.to_csv(score_path, index=True)

print("Evaluation period:")
print(df_out_eval["date"].min(), "to", df_out_eval["date"].max())

print("R2 OOS and p-values:")
print(df_score)

print("Saved files:")
print(pred_all_path)
print(pred_eval_path)
print(score_path)
