import gc
import glob
import numpy as np
import pandas as pd

from sklearn.preprocessing import StandardScaler
from tensorflow import keras
from tensorflow.keras import layers, regularizers

import statsmodels.api as sm
from scipy.stats import t as tstat


# ==================================================
# 0. Settings
# ==================================================

