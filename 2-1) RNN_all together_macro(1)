df = pd.read_csv(DATA_PATH)

df_sort = df.copy().sort_values("date").reset_index(drop=True)
df_sort["date"] = df_sort["date"].round(2)

required_base_cols = ["date"] + x_columns + y_columns
missing_base_cols = [
    c for c in required_base_cols
    if c not in df_sort.columns
]

if len(missing_base_cols) > 0:
    raise ValueError(f"Missing required columns: {missing_base_cols}")

macro_columns = [
    c for c in df_sort.columns
    if c not in ["date"] + x_columns + y_columns
]

if len(macro_columns) == 0:
    raise ValueError("No macro columns found in the dataset.")

df_sort = df_sort.dropna(subset=x_columns + macro_columns).reset_index(drop=True)

dates = df_sort["date"]

if OOS_START_DATE not in set(dates):
    raise ValueError(f"OOS_START_DATE {OOS_START_DATE} not found in data.")

date_idx = df_sort[df_sort["date"] == OOS_START_DATE].index[0]

print("Data loaded.")
print("Date range:", df_sort["date"].min(), "to", df_sort["date"].max())
print("Number of yield predictors:", len(x_columns))
print("Number of macro predictors:", len(macro_columns))
print("RUN_SETTING:", RUN_SETTING)
print("N_MC:", N_MC, "N_AVG:", N_AVG)
print("VALIDATION_SPLIT:", VALIDATION_SPLIT)
print("EARLY_STOP_MONITOR:", EARLY_STOP_MONITOR)
print("MODEL_SELECTION_MONITOR:", MODEL_SELECTION_MONITOR)
print("STATE_LOSS_WEIGHT:", STATE_LOSS_WEIGHT)
print("XR_LOSS_WEIGHT:", XR_LOSS_WEIGHT)


# ==================================================
# 10. Recursive OOS forecasting
# ==================================================

model_name = "rnn_macro_all_together"
mode_name = RUN_SETTING
monitor_name = MODEL_SELECTION_MONITOR.replace("val_", "v").replace("_", "")
loss_name = f"state{STATE_LOSS_WEIGHT:g}_xr{XR_LOSS_WEIGHT:g}".replace(".", "p")

for t in dates.iloc[date_idx:]:

    if t > OOS_END_DATE:
        break

    date_str = f"{t:.2f}".replace(".", "_")

    result_file = (
        f"{SAVE_DIR}/result_{model_name}_"
        f"{mode_name}_"
        f"select_{monitor_name}_"
        f"{loss_name}_"
        f"h{H_DIM}_"
        f"lookback{LOOKBACK}_"
        f"mc{N_MC}_avg{N_AVG}_"
        f"{date_str}.csv"
    )

    if os.path.exists(result_file):
        print("Already done, skip:", t)
        continue

    print("Forecasting date:", t)

    train = df_sort[df_sort["date"] < t].copy()
    test = df_sort[df_sort["date"] == t].copy()

    if test.empty:
        print("  No test observation for date:", t)
        continue

    if test[y_columns].isna().any(axis=None):
        print("  Missing target for date, skip:", t)
        continue

    test_index = test.index[0]

    X_past_train, X_state_train, M_train, Y_train, train_target_dates = make_macro_transition_train_samples(
        data=train,
        x_columns=x_columns,
        macro_columns=macro_columns,
        y_columns=y_columns,
        lookback=LOOKBACK
    )

    if len(Y_train) == 0:
        print("  Not enough training samples, skip:", t)
        continue

    X_past_test, M_test, X_state_test = make_macro_transition_test_sample(
        df_sort=df_sort,
        test_index=test_index,
        x_columns=x_columns,
        macro_columns=macro_columns,
        lookback=LOOKBACK
    )

    y_test = test[y_columns]
    x_state_test = test[x_columns]

    # Historical mean benchmark
    hist_mean = pd.DataFrame(Y_train, columns=y_columns).mean().values

    # ------------------------------
    # Scale yield path/state using train only
    # ------------------------------
    x_scaler = StandardScaler()
    x_scaler.fit(train[x_columns].dropna().values)

    X_past_train_scaled = scale_rnn_sequences(x_scaler, X_past_train)
    X_past_test_scaled = scale_rnn_sequences(x_scaler, X_past_test)

    X_state_train_scaled = x_scaler.transform(X_state_train)

    # ------------------------------
    # Scale macro using train only
    # ------------------------------
    macro_scaler = StandardScaler()
    macro_scaler.fit(train[macro_columns].dropna().values)

    M_train_scaled = macro_scaler.transform(M_train)
    M_test_scaled = macro_scaler.transform(M_test)

    # ------------------------------
    # Scale Y using train only
    # ------------------------------
    y_scaler = StandardScaler()
    Y_train_scaled = y_scaler.fit_transform(Y_train)

    pred_xr_candidates = []
    pred_state_candidates = []

    loss_candidates = []
    total_loss_candidates = []
    xr_loss_candidates = []
    state_loss_candidates = []
    total_val_loss_candidates = []
    val_xr_loss_candidates = []
    val_state_loss_candidates = []

    for seed in range(N_MC):
        print("  Macro all-together RNN seed:", seed)

        (
            pred_state_scaled,
            pred_xr_scaled,
            model_loss,
            total_loss,
            xr_loss,
            state_loss,
            total_val_loss,
            val_xr_loss,
            val_state_loss
        ) = fit_one_macro_all_together_rnn(
            X_past_train_scaled=X_past_train_scaled,
            X_state_train_scaled=X_state_train_scaled,
            M_train_scaled=M_train_scaled,
            Y_train_scaled=Y_train_scaled,
            X_past_test_scaled=X_past_test_scaled,
            M_test_scaled=M_test_scaled,
            seed=seed
        )

        pred_xr_candidates.append(pred_xr_scaled[0])
        pred_state_candidates.append(pred_state_scaled[0])

        loss_candidates.append(model_loss)
        total_loss_candidates.append(total_loss)
        xr_loss_candidates.append(xr_loss)
        state_loss_candidates.append(state_loss)
        total_val_loss_candidates.append(total_val_loss)
        val_xr_loss_candidates.append(val_xr_loss)
        val_state_loss_candidates.append(val_state_loss)

        print(
            f"    {MODEL_SELECTION_MONITOR}:",
            model_loss,
            "| loss:", total_loss,
            "| xr_loss:", xr_loss,
            "| val_loss:", total_val_loss,
            "| val_xr_loss:", val_xr_loss
        )

    pred_xr_candidates = np.array(pred_xr_candidates)
    pred_state_candidates = np.array(pred_state_candidates)

    loss_candidates = np.array(loss_candidates)
    total_loss_candidates = np.array(total_loss_candidates)
    xr_loss_candidates = np.array(xr_loss_candidates)
    state_loss_candidates = np.array(state_loss_candidates)
    total_val_loss_candidates = np.array(total_val_loss_candidates)
    val_xr_loss_candidates = np.array(val_xr_loss_candidates)
    val_state_loss_candidates = np.array(val_state_loss_candidates)

    top_idx = np.argsort(loss_candidates)[:N_AVG]

    print("  Top model indices:", top_idx)
    print(f"  Top {MODEL_SELECTION_MONITOR} losses:", loss_candidates[top_idx])

    pred_xr_scaled_avg = pred_xr_candidates[top_idx].mean(axis=0).reshape(1, -1)
    pred_state_scaled_avg = pred_state_candidates[top_idx].mean(axis=0).reshape(1, -1)

    y_pred = y_scaler.inverse_transform(pred_xr_scaled_avg)
    x_state_pred = x_scaler.inverse_transform(pred_state_scaled_avg)

    one_result = pd.DataFrame({"date": [t]})

    for i, y in enumerate(y_columns):
        one_result[f"pred_{y}"] = y_pred[0, i]
        one_result[f"true_{y}"] = y_test.iloc[0].values[i]
        one_result[f"hist_{y}"] = hist_mean[i]

    for i, x in enumerate(x_columns):
        one_result[f"pred_state_{x}"] = x_state_pred[0, i]
        one_result[f"true_state_{x}"] = x_state_test.iloc[0].values[i]

    one_result["RUN_SETTING"] = RUN_SETTING
    one_result["N_MC"] = N_MC
    one_result["N_AVG"] = N_AVG
    one_result["VALIDATION_SPLIT"] = VALIDATION_SPLIT
    one_result["EARLY_STOP_MONITOR"] = EARLY_STOP_MONITOR
    one_result["MODEL_SELECTION_MONITOR"] = MODEL_SELECTION_MONITOR
    one_result["LOOKBACK"] = LOOKBACK
    one_result["N_LAYERS"] = N_LAYERS
    one_result["H_DIM"] = H_DIM
    one_result["DENSE_DIM"] = DENSE_DIM
    one_result["N_MACRO_PREDICTORS"] = len(macro_columns)
    one_result["STATE_LOSS_WEIGHT"] = STATE_LOSS_WEIGHT
    one_result["XR_LOSS_WEIGHT"] = XR_LOSS_WEIGHT
    one_result["MERGE_DROPOUT"] = MERGE_DROPOUT

    one_result["loss_best"] = loss_candidates[top_idx[0]]
    one_result["loss_avg_top"] = loss_candidates[top_idx].mean()

    one_result["total_loss_best"] = total_loss_candidates[top_idx[0]]
    one_result["total_loss_avg_top"] = total_loss_candidates[top_idx].mean()

    one_result["xr_loss_best"] = xr_loss_candidates[top_idx[0]]
    one_result["xr_loss_avg_top"] = xr_loss_candidates[top_idx].mean()

    one_result["state_loss_best"] = state_loss_candidates[top_idx[0]]
    one_result["state_loss_avg_top"] = state_loss_candidates[top_idx].mean()

    one_result["total_val_loss_best"] = total_val_loss_candidates[top_idx[0]]
    one_result["total_val_loss_avg_top"] = total_val_loss_candidates[top_idx].mean()

    one_result["val_xr_loss_best"] = val_xr_loss_candidates[top_idx[0]]
    one_result["val_xr_loss_avg_top"] = val_xr_loss_candidates[top_idx].mean()

    one_result["val_state_loss_best"] = val_state_loss_candidates[top_idx[0]]
    one_result["val_state_loss_avg_top"] = val_state_loss_candidates[top_idx].mean()

    one_result.to_csv(result_file, index=False)

    print("Saved:", result_file)


# ==================================================
# 11. Load saved results
# ==================================================

pattern = (
    f"{SAVE_DIR}/result_{model_name}_"
    f"{mode_name}_"
    f"select_{monitor_name}_"
    f"{loss_name}_"
    f"h{H_DIM}_"
    f"lookback{LOOKBACK}_"
    f"mc{N_MC}_avg{N_AVG}_"
    f"*.csv"
)

files = sorted(glob.glob(pattern))

if len(files) == 0:
    raise ValueError("No saved result files found.")

df_out = pd.concat(
    [pd.read_csv(f) for f in files],
    axis=0,
    ignore_index=True
)

df_out = df_out.sort_values("date").reset_index(drop=True)

df_out_eval = df_out[
    (df_out["date"] >= OOS_START_DATE)
    & (df_out["date"] <= OOS_END_DATE)
].copy()


# ==================================================
# 12. Compute R2 OOS and p-values
# ==================================================

r2_score_list = []
p_value_list = []

for y in y_columns:
    r2_score = r2_oos(
        df_out_eval[f"true_{y}"],
        df_out_eval[f"pred_{y}"],
        df_out_eval[f"hist_{y}"]
    )

    p_value = rsz_signif(
        df_out_eval[f"true_{y}"],
        df_out_eval[f"pred_{y}"],
        df_out_eval[f"hist_{y}"]
    )

    r2_score_list.append(r2_score)
    p_value_list.append(p_value)

df_score = pd.DataFrame(
    [r2_score_list, p_value_list],
    index=["R2_oos", "p_value"],
    columns=y_columns
)


# ==================================================
# 13. State prediction diagnostics
# ==================================================

state_mse_list = []
state_r2_list = []

for x in x_columns:
    true_x = df_out_eval[f"true_state_{x}"]
    pred_x = df_out_eval[f"pred_state_{x}"]

    mse = ((true_x - pred_x) ** 2).mean()

    denominator = ((true_x - true_x.mean()) ** 2).sum()
    numerator = ((true_x - pred_x) ** 2).sum()

    state_r2 = 1 - numerator / denominator if denominator != 0 else np.nan

    state_mse_list.append(mse)
    state_r2_list.append(state_r2)

df_state_score = pd.DataFrame(
    [state_mse_list, state_r2_list],
    index=["state_mse", "state_R2"],
    columns=x_columns
)


