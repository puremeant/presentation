# ==================================================
# 5. Helper functions
# ==================================================

def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    keras.utils.set_random_seed(seed)


def r2_oos(y_true, y_pred, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_pred = np.asarray(y_pred).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    numerator = np.nansum((y_true - y_pred) ** 2)
    denominator = np.nansum((y_true - y_hist_mean) ** 2)

    if denominator == 0:
        return np.nan

    return 1 - numerator / denominator


def rsz_signif(y_true, y_forecast, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_forecast = np.asarray(y_forecast).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    f = (
        (y_true - y_hist_mean) ** 2
        - (y_true - y_forecast) ** 2
        + (y_hist_mean - y_forecast) ** 2
    )

    x = np.ones(len(f))

    model = sm.OLS(f, x, missing="drop", hasconst=True)
    results = model.fit(cov_type="HAC", cov_kwds={"maxlags": 12})

    t_value = np.asarray(results.tvalues).ravel()[0]

    return 1 - tstat.cdf(t_value, results.nobs - 1)


def scale_rnn_sequences(scaler, X_seq):
    """
    StandardScaler expects 2D data.
    RNN input is 3D: (n_samples, lookback, n_features).
    So reshape:
        (n_samples, lookback, n_features)
    into:
        (n_samples * lookback, n_features)
    then reshape back.
    """
    n_samples, lookback, n_features = X_seq.shape

    X_scaled = scaler.transform(
        X_seq.reshape(-1, n_features)
    ).reshape(n_samples, lookback, n_features)

    return X_scaled


# ==================================================
# 6. Make macro-path RNN samples
# ==================================================

def make_macro_path_train_samples(
    data,
    x_columns,
    macro_columns,
    y_columns,
    lookback
):
    """
    For target date t:

        Yield path:
            x_{t-12}, ..., x_{t-1}

        Macro path:
            m_{t-12}, ..., m_{t-1}

        State target:
            x_t

        Return target:
            xr_t

    This model does NOT use current macro m_t.
    It uses the past macro path only.
    """

    data = data.sort_values("date").reset_index(drop=True)

    x_path_list = []
    m_path_list = []
    state_target_list = []
    y_target_list = []
    target_dates = []

    for current_idx in range(lookback, len(data)):

        past_start = current_idx - lookback
        past_end = current_idx

        x_path = data.iloc[past_start:past_end][x_columns]
        m_path = data.iloc[past_start:past_end][macro_columns]
        state_target = data.iloc[current_idx][x_columns]
        y_target = data.iloc[current_idx][y_columns]

        if x_path.isna().any().any():
            continue

        if m_path.isna().any().any():
            continue

        if state_target.isna().any():
            continue

        if y_target.isna().any():
            continue

        x_path_list.append(x_path.values)
        m_path_list.append(m_path.values)
        state_target_list.append(state_target.values)
        y_target_list.append(y_target.values)
        target_dates.append(data.iloc[current_idx]["date"])

    X_path = np.array(x_path_list)
    M_path = np.array(m_path_list)
    X_state_target = np.array(state_target_list)
    Y = np.array(y_target_list)
    target_dates = np.array(target_dates)

    return X_path, M_path, X_state_target, Y, target_dates


def make_macro_path_test_sample(
    df_sort,
    test_index,
    x_columns,
    macro_columns,
    lookback
):
    """
    For forecast date t:

        Yield path:
            x_{t-12}, ..., x_{t-1}

        Macro path:
            m_{t-12}, ..., m_{t-1}

        State target for diagnostics:
            x_t
    """

    past_start = test_index - lookback
    past_end = test_index

    if past_start < 0:
        raise ValueError("Not enough historical observations to construct test sequence.")

    X_path_test = df_sort.iloc[past_start:past_end][x_columns].values
    X_path_test = X_path_test.reshape(1, lookback, len(x_columns))

    M_path_test = df_sort.iloc[past_start:past_end][macro_columns].values
    M_path_test = M_path_test.reshape(1, lookback, len(macro_columns))

    X_state_test = df_sort.iloc[test_index][x_columns].values
    X_state_test = X_state_test.reshape(1, len(x_columns))

    return X_path_test, M_path_test, X_state_test


# ==================================================
# 7. Build macro-path f-net RNN
# ==================================================

def build_macro_path_fnet_rnn(
    lookback,
    x_dim,
    macro_dim,
    y_dim,
    yield_n_layers,
    yield_h_dim,
    macro_n_layers,
    macro_h_dim,
    dense_dim,
    activation,
    learning_rate,
    seed
):
    """
    Macro path f-net RNN:

        x_{t-12:t-1} -> yield LSTM -> h_x,t
        m_{t-12:t-1} -> macro LSTM -> h_m,t

        [h_x,t, h_m,t] -> forecast head -> xr_t

    Auxiliary state head:
        h_x,t -> x_hat_t

    The auxiliary state head uses the yield-path representation only,
    because it is meant to force h_x,t to summarize the yield curve transition.
    """

    set_seed(seed)

    # ------------------------------
    # Yield path branch
    # ------------------------------
    yield_input = keras.Input(
        shape=(lookback, x_dim),
        name="yield_path_input"
    )

    y_layer = yield_input

    for layer_id in range(max(yield_n_layers - 1, 0)):
        y_layer = layers.LSTM(
            32,
            return_sequences=True,
            recurrent_initializer="orthogonal",
            name=f"yield_lstm_sequence_{layer_id + 1}"
        )(y_layer)

        y_layer = layers.LayerNormalization(
            name=f"yield_norm_sequence_{layer_id + 1}"
        )(y_layer)

    h_yield = layers.LSTM(
        yield_h_dim,
        return_sequences=False,
        recurrent_initializer="orthogonal",
        name="yield_path_representation_lstm"
    )(y_layer)

    h_yield = layers.LayerNormalization(
        name="yield_path_representation_norm"
    )(h_yield)

    # ------------------------------
    # Macro path branch
    # ------------------------------
    macro_input = keras.Input(
        shape=(lookback, macro_dim),
        name="macro_path_input"
    )

    m_layer = macro_input

    for layer_id in range(max(macro_n_layers - 1, 0)):
        m_layer = layers.LSTM(
            32,
            return_sequences=True,
            recurrent_initializer="orthogonal",
            name=f"macro_lstm_sequence_{layer_id + 1}"
        )(m_layer)

        m_layer = layers.LayerNormalization(
            name=f"macro_norm_sequence_{layer_id + 1}"
        )(m_layer)

    h_macro = layers.LSTM(
        macro_h_dim,
        return_sequences=False,
        recurrent_initializer="orthogonal",
        name="macro_path_representation_lstm"
    )(m_layer)

    h_macro = layers.LayerNormalization(
        name="macro_path_representation_norm"
    )(h_macro)

    # ------------------------------
    # Auxiliary state-transition head
    # h_yield -> x_hat_t
    # ------------------------------
    state_hidden = layers.Dense(
        dense_dim,
        activation=activation,
        name="state_transition_hidden"
    )(h_yield)

    state_output = layers.Dense(
        x_dim,
        activation="linear",
        name="state_output"
    )(state_hidden)

    # ------------------------------
    # Return forecast head
    # [h_yield, h_macro] -> xr_t
    # ------------------------------
    merged = layers.Concatenate(
        name="merge_yield_and_macro_path_states"
    )([h_yield, h_macro])

    merged = layers.Dropout(
        MERGE_DROPOUT,
        name="dropout_after_path_merge"
    )(merged)

    xr_hidden = layers.Dense(
        dense_dim,
        activation=activation,
        name="xr_forecast_hidden"
    )(merged)

    xr_output = layers.Dense(
        y_dim,
        activation="linear",
        name="xr_output"
    )(xr_hidden)

    model = keras.Model(
        inputs=[yield_input, macro_input],
        outputs=[state_output, xr_output],
        name="macro_path_fnet_state_transition_rnn"
    )

    optimizer = keras.optimizers.Adam(
        learning_rate=learning_rate
    )

    model.compile(
        optimizer=optimizer,
        loss={
            "state_output": "mse",
            "xr_output": "mse"
        },
        loss_weights={
            "state_output": STATE_LOSS_WEIGHT,
            "xr_output": XR_LOSS_WEIGHT
        }
    )

    return model


# ==================================================
# 8. Fit one RNN
# ==================================================

def fit_one_macro_path_fnet_rnn(
    X_path_train_scaled,
    M_path_train_scaled,
    X_state_train_scaled,
    Y_train_scaled,
    X_path_test_scaled,
    M_path_test_scaled,
    seed
):
    keras.backend.clear_session()

    model = build_macro_path_fnet_rnn(
        lookback=X_path_train_scaled.shape[1],
        x_dim=X_path_train_scaled.shape[2],
        macro_dim=M_path_train_scaled.shape[2],
        y_dim=Y_train_scaled.shape[1],
        yield_n_layers=YIELD_N_LAYERS,
        yield_h_dim=YIELD_H_DIM,
        macro_n_layers=MACRO_N_LAYERS,
        macro_h_dim=MACRO_H_DIM,
        dense_dim=DENSE_DIM,
        activation=ACTIVATION,
        learning_rate=LEARNING_RATE,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor=EARLY_STOP_MONITOR,
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=0,
        mode="auto",
        restore_best_weights=True
    )

    history = model.fit(
        [X_path_train_scaled, M_path_train_scaled],
        {
            "state_output": X_state_train_scaled,
            "xr_output": Y_train_scaled
        },
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=VALIDATION_SPLIT,
        shuffle=False,
        verbose=0,
        callbacks=[early_stop]
    )

    model_loss = min(history.history[EARLY_STOP_MONITOR])

    pred_state_scaled, pred_xr_scaled = model.predict(
        [X_path_test_scaled, M_path_test_scaled],
        verbose=0
    )

    del model
    keras.backend.clear_session()
    gc.collect()

    return pred_state_scaled, pred_xr_scaled, model_loss


