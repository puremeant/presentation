# NN architecture
N_HIDDEN_LAYERS = 1
HIDDEN_NODES = 7
ACTIVATION = "relu"

# Training
EPOCHS = 500
BATCH_SIZE = 32
PATIENCE = 20

# Author-style optimizer settings
INITIAL_LEARNING_RATE = 0.01
DECAY_RATE = 0.01
MOMENTUM = 0.9

# Hyperparameter grid
NN_PARAMS = {
    "Dropout": [0.1, 0.3, 0.5],
    "l1l2": [0.01, 0.001]
}


