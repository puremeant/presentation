    (df_out["date"] >= OOS_START_DATE)
    & (df_out["date"] <= OOS_END_DATE)
].copy()


# ==================================================
# 12. Compute R2 OOS and p-values
# ==================================================

r2_score_list = []
p_value_list = []

for y in y_columns:
    r2_score = r2_oos(
        df_out_eval[f"true_{y}"],
        df_out_eval[f"pred_{y}"],
        df_out_eval[f"hist_{y}"]
    )

    p_value = rsz_signif(
        df_out_eval[f"true_{y}"],
        df_out_eval[f"pred_{y}"],
        df_out_eval[f"hist_{y}"]
    )

    r2_score_list.append(r2_score)
    p_value_list.append(p_value)

df_score = pd.DataFrame(
    [r2_score_list, p_value_list],
    index=["R2_oos", "p_value"],
    columns=y_columns
)


# ==================================================
# 13. State prediction diagnostics
# ==================================================

state_mse_list = []
state_r2_list = []

for x in x_columns:
    true_x = df_out_eval[f"true_state_{x}"]
    pred_x = df_out_eval[f"pred_state_{x}"]

    mse = ((true_x - pred_x) ** 2).mean()

    denominator = ((true_x - true_x.mean()) ** 2).sum()
    numerator = ((true_x - pred_x) ** 2).sum()

    state_r2 = 1 - numerator / denominator if denominator != 0 else np.nan

    state_mse_list.append(mse)
    state_r2_list.append(state_r2)

df_state_score = pd.DataFrame(
    [state_mse_list, state_r2_list],
    index=["state_mse", "state_R2"],
    columns=x_columns
)


