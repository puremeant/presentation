# ==================================================
# 5. Helper functions
# ==================================================

def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    keras.utils.set_random_seed(seed)


def r2_oos(y_true, y_pred, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_pred = np.asarray(y_pred).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    numerator = np.nansum((y_true - y_pred) ** 2)
    denominator = np.nansum((y_true - y_hist_mean) ** 2)

    if denominator == 0:
        return np.nan

    return 1 - numerator / denominator


def rsz_signif(y_true, y_forecast, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_forecast = np.asarray(y_forecast).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    f = (
        (y_true - y_hist_mean) ** 2
        - (y_true - y_forecast) ** 2
        + (y_hist_mean - y_forecast) ** 2
    )

    x = np.ones(len(f))

    model = sm.OLS(f, x, missing="drop", hasconst=True)
    results = model.fit(cov_type="HAC", cov_kwds={"maxlags": 12})

    t_value = np.asarray(results.tvalues).ravel()[0]

    return 1 - tstat.cdf(t_value, results.nobs - 1)


def scale_joint_sequences(joint_scaler, Z_seq):
    """
    StandardScaler expects 2D data.
    Joint RNN input is 3D:
        (n_samples, lookback, joint_dim)

    We reshape:
        (n_samples * lookback, joint_dim)
    then reshape back.
    """
    n_samples, lookback, joint_dim = Z_seq.shape

    Z_scaled = joint_scaler.transform(
        Z_seq.reshape(-1, joint_dim)
    ).reshape(n_samples, lookback, joint_dim)

    return Z_scaled


# ==================================================
# 6. Make joint-path RNN samples
# ==================================================

def make_joint_path_train_samples(
    data,
    x_columns,
    macro_columns,
    y_columns,
    lookback
):
    """
    For target date t:

        Joint path:
            [x_{t-12}, m_{t-12}],
            [x_{t-11}, m_{t-11}],
            ...,
            [x_{t-1}, m_{t-1}]

        State target:
            x_t

        Return target:
            xr_t

    This model does NOT use current macro m_t directly.
    It uses the past joint yield-macro path only.
    """

    data = data.sort_values("date").reset_index(drop=True)

    joint_path_list = []
    state_target_list = []
    y_target_list = []
    target_dates = []

    joint_columns = x_columns + macro_columns

    for current_idx in range(lookback, len(data)):

        past_start = current_idx - lookback
        past_end = current_idx

        joint_path = data.iloc[past_start:past_end][joint_columns]
        state_target = data.iloc[current_idx][x_columns]
        y_target = data.iloc[current_idx][y_columns]

        if joint_path.isna().any().any():
            continue

        if state_target.isna().any():
            continue

        if y_target.isna().any():
            continue

        joint_path_list.append(joint_path.values)
        state_target_list.append(state_target.values)
        y_target_list.append(y_target.values)
        target_dates.append(data.iloc[current_idx]["date"])

    Z_path = np.array(joint_path_list)
    X_state_target = np.array(state_target_list)
    Y = np.array(y_target_list)
    target_dates = np.array(target_dates)

    return Z_path, X_state_target, Y, target_dates


def make_joint_path_test_sample(
    df_sort,
    test_index,
    x_columns,
    macro_columns,
    lookback
):
    """
    For forecast date t:

        Joint path:
            [x_{t-12}, m_{t-12}], ..., [x_{t-1}, m_{t-1}]

        State target for diagnostics:
            x_t
    """

    past_start = test_index - lookback
    past_end = test_index

    if past_start < 0:
        raise ValueError("Not enough historical observations to construct test sequence.")

    joint_columns = x_columns + macro_columns

    Z_path_test = df_sort.iloc[past_start:past_end][joint_columns].values
    Z_path_test = Z_path_test.reshape(1, lookback, len(joint_columns))

    X_state_test = df_sort.iloc[test_index][x_columns].values
    X_state_test = X_state_test.reshape(1, len(x_columns))

    return Z_path_test, X_state_test


# ==================================================
# 7. Build joint-path f-net RNN
# ==================================================

def build_joint_path_fnet_rnn(
    lookback,
    joint_dim,
    x_dim,
    y_dim,
    n_layers,
    h_dim,
    dense_dim,
    activation,
    learning_rate,
    seed
):
    """
    Joint path RNN:

        [x_s, m_s]_{s=t-12}^{t-1}
            -> LSTM
            -> h_xm,t

        h_xm,t -> x_hat_t
        h_xm,t -> xr_hat_t

    This model allows yield and macro variables to interact within each month
    before recurrent updating.
    """

    set_seed(seed)

    # ------------------------------
    # Joint yield-macro path input
    # ------------------------------
    joint_input = keras.Input(
        shape=(lookback, joint_dim),
        name="joint_yield_macro_path"
    )

    hidden_layer = joint_input

    for layer_id in range(max(n_layers - 1, 0)):
        hidden_layer = layers.LSTM(
            32,
            return_sequences=True,
            recurrent_initializer="orthogonal",
            name=f"joint_lstm_sequence_{layer_id + 1}"
        )(hidden_layer)

        hidden_layer = layers.LayerNormalization(
            name=f"joint_norm_sequence_{layer_id + 1}"
        )(hidden_layer)

    h_joint = layers.LSTM(
        h_dim,
        return_sequences=False,
        recurrent_initializer="orthogonal",
        name="joint_path_representation_lstm"
    )(hidden_layer)

    h_joint = layers.LayerNormalization(
        name="joint_path_representation_norm"
    )(h_joint)

    h_joint = layers.Dropout(
        REP_DROPOUT,
        name="dropout_after_joint_representation"
    )(h_joint)

    # ------------------------------
    # Auxiliary state-transition head
    # h_xm,t -> x_hat_t
    # ------------------------------
    state_hidden = layers.Dense(
        dense_dim,
        activation=activation,
        name="state_transition_hidden"
    )(h_joint)

    state_output = layers.Dense(
        x_dim,
        activation="linear",
        name="state_output"
    )(state_hidden)

    # ------------------------------
    # Return forecast head
    # h_xm,t -> xr_t
    # ------------------------------
    xr_hidden = layers.Dense(
        dense_dim,
        activation=activation,
        name="xr_forecast_hidden"
    )(h_joint)

    xr_output = layers.Dense(
        y_dim,
        activation="linear",
        name="xr_output"
    )(xr_hidden)

    model = keras.Model(
        inputs=joint_input,
        outputs=[state_output, xr_output],
        name="joint_path_fnet_state_transition_rnn"
    )

    optimizer = keras.optimizers.Adam(
        learning_rate=learning_rate
    )

    model.compile(
        optimizer=optimizer,
        loss={
            "state_output": "mse",
            "xr_output": "mse"
        },
        loss_weights={
            "state_output": STATE_LOSS_WEIGHT,
            "xr_output": XR_LOSS_WEIGHT
        }
    )

    return model


# ==================================================
# 8. Fit one RNN
# ==================================================

def fit_one_joint_path_fnet_rnn(
    Z_path_train_scaled,
    X_state_train_scaled,
    Y_train_scaled,
    Z_path_test_scaled,
    seed
):
    keras.backend.clear_session()

    model = build_joint_path_fnet_rnn(
        lookback=Z_path_train_scaled.shape[1],
        joint_dim=Z_path_train_scaled.shape[2],
        x_dim=X_state_train_scaled.shape[1],
        y_dim=Y_train_scaled.shape[1],
        n_layers=N_LAYERS,
        h_dim=H_DIM,
        dense_dim=DENSE_DIM,
        activation=ACTIVATION,
        learning_rate=LEARNING_RATE,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor=EARLY_STOP_MONITOR,
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=0,
        mode="auto",
        restore_best_weights=True
    )

    history = model.fit(
        Z_path_train_scaled,
        {
            "state_output": X_state_train_scaled,
            "xr_output": Y_train_scaled
        },
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=VALIDATION_SPLIT,
        shuffle=False,
        verbose=0,
        callbacks=[early_stop]
    )

    model_loss = min(history.history[EARLY_STOP_MONITOR])

    pred_state_scaled, pred_xr_scaled = model.predict(
        Z_path_test_scaled,
        verbose=0
    )

    del model
    keras.backend.clear_session()
    gc.collect()

    return pred_state_scaled, pred_xr_scaled, model_loss


