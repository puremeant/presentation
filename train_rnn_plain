# ==================================================
# 1. OOS R2 and p-value functions
# ==================================================

def r2_oos(y_true, y_pred, y_hist_mean):
    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()
    return 1 - (numerator / denominator)


def rsz_signif(y_true, y_forecast, y_hist_mean):
    f = ((y_true - y_hist_mean) ** 2
         - (y_true - y_forecast) ** 2
         + (y_hist_mean - y_forecast) ** 2)

    x = np.ones(np.shape(f))

    model = sm.OLS(f, x, missing='drop', hasconst=True)
    results = model.fit(cov_type='HAC', cov_kwds={'maxlags': 12})

    return 1 - tstat.cdf(results.tvalues[0], results.nobs - 1)


# ==================================================
# 2. Make RNN samples
# ==================================================

def make_rnn_train_samples(data, x_columns, y_columns, lookback):
    """
    For each target date s in the training sample:

        past path     = x_{s-12}, ..., x_{s-1}
        current state = x_s
        target        = xr_s

    This lets the RNN summarize past yield-curve states while separately
    controlling for the current yield-curve state.
    """

    data = data.sort_values("date").reset_index(drop=True)

    past_seq_list = []
    current_x_list = []
    y_list = []
    target_dates = []

    for current_idx in range(lookback, len(data)):
        past_start = current_idx - lookback
        past_end = current_idx

        y_val = data.iloc[current_idx][y_columns]

        # Skip rows with missing target values
        if y_val.isna().any():
            continue

        past_seq = data.iloc[past_start:past_end][x_columns].values
        current_x = data.iloc[current_idx][x_columns].values
        date_val = data.iloc[current_idx]["date"]

        past_seq_list.append(past_seq)
        current_x_list.append(current_x)
        y_list.append(y_val.values)
        target_dates.append(date_val)

    X_past = np.array(past_seq_list)
    X_current = np.array(current_x_list)
    Y = np.array(y_list)
    target_dates = np.array(target_dates)

    return X_past, X_current, Y, target_dates


def make_rnn_test_sample(df_sort, test_index, x_columns, lookback):
    """
    For forecast date t:

        past path     = x_{t-12}, ..., x_{t-1}
        current state = x_t

    The target is xr_t, which is the realized future one-year excess return
    attached to row t.
    """

    past_start = test_index - lookback
    past_end = test_index

    if past_start < 0:
        raise ValueError("Not enough historical observations to construct test sequence.")

    X_past_test = df_sort.iloc[past_start:past_end][x_columns].values
    X_current_test = df_sort.iloc[test_index][x_columns].values

    X_past_test = X_past_test.reshape(1, lookback, len(x_columns))
    X_current_test = X_current_test.reshape(1, len(x_columns))

    return X_past_test, X_current_test


def scale_rnn_past_sequences(x_scaler, X_past):
    """
    Scale 3D RNN input using a StandardScaler fitted on training X only.
    """

    n_samples, lookback, n_features = X_past.shape

    X_scaled = x_scaler.transform(
        X_past.reshape(-1, n_features)
    ).reshape(n_samples, lookback, n_features)

    return X_scaled


# ==================================================
# 3. Build LSTM RNN
# ==================================================

def build_lstm_rnn(lookback, x_dim, y_dim, n_layers, h_dim,
                   dense_dim, activation, seed):

    np.random.seed(seed)
    keras.utils.set_random_seed(seed)

    # Past yield-curve path input: x_{t-12}, ..., x_{t-1}
    past_input = keras.Input(
        shape=(lookback, x_dim),
        name='past_yield_curve_path'
    )

    hidden_layer = past_input

    # Optional stacked LSTM layers.
    # These keep the whole sequence so another LSTM can read it.
    for _ in range(max(n_layers - 1, 0)):
        hidden_layer = layers.LSTM(
            32,
            return_sequences=True,
            recurrent_initializer='orthogonal'
        )(hidden_layer)

        hidden_layer = layers.LayerNormalization()(hidden_layer)

    # Final LSTM summarizes the historical path into one vector.
    rep_layer = layers.LSTM(
        h_dim,
        return_sequences=False,
        recurrent_initializer='orthogonal',
        name='path_representation_lstm'
    )(hidden_layer)

    rep_layer = layers.LayerNormalization(name='path_representation_norm')(rep_layer)

    # Optional interpretable one-dimensional latent path state.
    # This is not used as a model output for training; it can be extracted later.
    state_layer = layers.Dense(
        1,
        activation='linear',
        name='latent_path_state'
    )(rep_layer)

    # Current yield-curve state input: x_t
    current_input = keras.Input(
        shape=(x_dim,),
        name='current_yield_curve_state'
    )

    # Combine path summary and current state.
    merged = layers.Concatenate(name='merge_path_and_current')(
        [rep_layer, current_input]
    )

    hidden_layer2 = layers.Dense(
        dense_dim,
        activation=activation,
        name='forecast_hidden_layer'
    )(merged)

    output_layer = layers.Dense(
        y_dim,
        activation='linear',
        name='xr_forecast'
    )(hidden_layer2)

    model = keras.Model(
        inputs=[past_input, current_input],
        outputs=output_layer
    )

    # Separate model to extract the latent path state if needed.
    state_model = keras.Model(
        inputs=[past_input, current_input],
        outputs=state_layer
    )

    optimizer = keras.optimizers.Adam(
        learning_rate=LEARNING_RATE
    )

    model.compile(
        optimizer=optimizer,
        loss='mse'
    )

    return model, state_model


# ==================================================
# 4. Fit one RNN model
# ==================================================

def fit_one_rnn(X_past_train_scaled, X_current_train_scaled,
                y_train_scaled,
                X_past_test_scaled, X_current_test_scaled,
                seed):

    keras.backend.clear_session()

    rnn_model, state_model = build_lstm_rnn(
        lookback=X_past_train_scaled.shape[1],
        x_dim=X_past_train_scaled.shape[2],
        y_dim=y_train_scaled.shape[1],
        n_layers=N_LAYERS,
        h_dim=H_DIM,
        dense_dim=DENSE_DIM,
        activation=ACTIVATION,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor='val_loss',
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=0,
        mode='auto',
        restore_best_weights=True
    )

    history = rnn_model.fit(
        [X_past_train_scaled, X_current_train_scaled],
        y_train_scaled,
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=0.15,
        shuffle=False,
        verbose=0,
        callbacks=[early_stop]
    )

    val_loss = min(history.history['val_loss'])

    pred_scaled = rnn_model.predict(
        [X_past_test_scaled, X_current_test_scaled],
        verbose=0
    )

    path_state = state_model.predict(
        [X_past_test_scaled, X_current_test_scaled],
        verbose=0
    )

    del rnn_model
    del state_model
    keras.backend.clear_session()
    gc.collect()

    return pred_scaled, val_loss, path_state


