x_columns = ['0f1', '1f1', '2f1', '3f1', '4f1',
             '5f1', '6f1', '7f1', '8f1', '9f1']

y_columns = ['xr24', 'xr36', 'xr48', 'xr60', 'xr84', 'xr120']

df_sort = df.copy().sort_values("date").reset_index(drop=True)
df_sort["date"] = df_sort["date"].round(2)

# Keep only rows where X exists.
df_sort = df_sort.dropna(subset=x_columns).reset_index(drop=True)

dates = df_sort["date"]

if OOS_START_DATE not in set(dates):
    raise ValueError(f"OOS_START_DATE {OOS_START_DATE} not found in data.")

date_idx = df_sort[df_sort["date"] == OOS_START_DATE].index[0]


# ==================================================
# 6. Recursive OOS forecasting
# ==================================================

mode_name = "ensemble" if USE_ENSEMBLE else "single"

for t in dates.iloc[date_idx:]:

    if t > OOS_END_DATE:
        continue

    date_str = f"{t:.2f}".replace(".", "_")

    result_file = (
        f"{SAVE_DIR}/result_lstm_rnn_"
        f"{mode_name}_"
        f"h{H_DIM}_"
        f"lookback{LOOKBACK}_"
        f"mc{N_MC}_avg{N_AVG}_"
        f"{date_str}.csv"
    )

    # 이미 저장된 날짜면 건너뛰기
    if os.path.exists(result_file):
        print("Already done, skip:", t)
        continue

    print("Forecasting date:", t)

    train = df_sort[df_sort["date"] < t]
    test = df_sort[df_sort["date"] == t]

    if test.empty:
        print("  No test observation for date:", t)
        continue

    # Skip if target is missing
    if test[y_columns].isna().any(axis=None):
        print("  Missing target for date, skip:", t)
        continue

    test_index = test.index[0]

    # Build RNN training samples
    X_past_train, X_current_train, y_train_seq, train_target_dates = make_rnn_train_samples(
        data=train,
        x_columns=x_columns,
        y_columns=y_columns,
        lookback=LOOKBACK
    )

    if len(y_train_seq) == 0:
        print("  Not enough training sequences, skip:", t)
        continue

    # Build test sample
    X_past_test, X_current_test = make_rnn_test_sample(
        df_sort=df_sort,
        test_index=test_index,
        x_columns=x_columns,
        lookback=LOOKBACK
    )

    y_test = test[y_columns]

    # Historical mean benchmark:
    # Use all available past realized returns before t, matching your static NN benchmark.
    y_train_available = train[y_columns].dropna()
    y_train_hist_mean = y_train_available.mean().values

    # Scale X using train only
    x_scaler = StandardScaler()
    x_scaler.fit(train[x_columns])

    X_past_train_scaled = scale_rnn_past_sequences(x_scaler, X_past_train)
    X_past_test_scaled = scale_rnn_past_sequences(x_scaler, X_past_test)

    X_current_train_scaled = x_scaler.transform(X_current_train)
    X_current_test_scaled = x_scaler.transform(X_current_test)

    # Scale Y using RNN training targets only
    y_scaler = StandardScaler()
    y_train_scaled = y_scaler.fit_transform(y_train_seq)

    pred_candidates = []
    val_loss_candidates = []
    path_state_candidates = []

    for seed in range(N_MC):
        print("  RNN seed:", seed)

        pred_scaled, val_loss, path_state = fit_one_rnn(
            X_past_train_scaled=X_past_train_scaled,
            X_current_train_scaled=X_current_train_scaled,
            y_train_scaled=y_train_scaled,
            X_past_test_scaled=X_past_test_scaled,
            X_current_test_scaled=X_current_test_scaled,
            seed=seed
        )

        pred_candidates.append(pred_scaled[0])
        val_loss_candidates.append(val_loss)
        path_state_candidates.append(path_state[0, 0])

        print("    Validation loss:", val_loss)

    pred_candidates = np.array(pred_candidates)
    val_loss_candidates = np.array(val_loss_candidates)
    path_state_candidates = np.array(path_state_candidates)

    # Top N_AVG by validation loss
    top_idx = np.argsort(val_loss_candidates)[:N_AVG]

    print("  Top model indices:", top_idx)
    print("  Top validation losses:", val_loss_candidates[top_idx])
    print("  Best validation loss:", val_loss_candidates[top_idx[0]])

    # Average selected predictions
    pred_scaled_avg = pred_candidates[top_idx].mean(axis=0).reshape(1, -1)
    path_state_avg = path_state_candidates[top_idx].mean()

    # Back to original excess-return units
    y_pred = y_scaler.inverse_transform(pred_scaled_avg)

    # Save one-date result
    one_result = pd.DataFrame({'date': [t]})

    for i, y in enumerate(y_columns):
        one_result[f'pred_{y}'] = y_pred[0, i]
        one_result[f'true_{y}'] = y_test.iloc[0].values[i]
        one_result[f'hist_{y}'] = y_train_hist_mean[i]

    one_result["path_state"] = path_state_avg
    one_result["N_MC"] = N_MC
    one_result["N_AVG"] = N_AVG
    one_result["LOOKBACK"] = LOOKBACK
    one_result["H_DIM"] = H_DIM
    one_result["N_LAYERS"] = N_LAYERS
    one_result["mode"] = mode_name

    one_result.to_csv(result_file, index=False)

    print("Saved:", result_file)


# ==================================================
# 7. Load saved results
# ==================================================

pattern = (
    f"{SAVE_DIR}/result_lstm_rnn_"
    f"{mode_name}_"
    f"h{H_DIM}_"
    f"lookback{LOOKBACK}_"
    f"mc{N_MC}_avg{N_AVG}_"
    f"*.csv"
)

files = sorted(glob.glob(pattern))

if len(files) == 0:
    raise ValueError("No saved result files found.")

df_out = pd.concat(
    [pd.read_csv(f) for f in files],
    axis=0,
    ignore_index=True
)

df_out = df_out.sort_values("date").reset_index(drop=True)

# Evaluation period
df_out_eval = df_out[
    (df_out["date"] >= OOS_START_DATE)
    & (df_out["date"] <= OOS_END_DATE)
].copy()


# ==================================================
# 8. Compute R2 OOS and p-value
# ==================================================

r2_score_list = []
p_value_list = []

for y in y_columns:
    r2_score = r2_oos(
        df_out_eval[f'true_{y}'],
        df_out_eval[f'pred_{y}'],
        df_out_eval[f'hist_{y}']
    )

    p_value = rsz_signif(
        df_out_eval[f'true_{y}'],
        df_out_eval[f'pred_{y}'],
        df_out_eval[f'hist_{y}']
    )

    r2_score_list.append(r2_score)
    p_value_list.append(p_value)

df_score = pd.DataFrame(
    [r2_score_list, p_value_list],
    index=['R2_oos', 'p_value'],
    columns=y_columns
)


# ==================================================
# 9. Save final results
# ==================================================

df_out.to_csv(
