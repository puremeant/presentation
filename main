import pandas as pd
import numpy as np

sheet_id = "1-wmStGZHLx55dSYi3gQK2vb3F8dMw_Nb"
sheet_name = "Sheet1"

url = (
    f"https://docs.google.com/spreadsheets/d/{sheet_id}/gviz/tq?"
    f"tqx=out:csv&sheet={sheet_name}"
)
print(url)
df = pd.read_csv(url)
df.columns.values[0] = 'date'
df.columns = df.columns.str.strip()

##### Preprocessing: Keep only maturities every 12 months: 12m, 24m, ..., 360m
cols = ['date', '12 m', '24 m', '36 m', '48 m', '60 m', '72 m', '84 m', '96 m', '108 m', '120 m']
df = df[cols] /100
print(df)

df['p12'] = -1 * df['12 m']
df['p24'] = -2 * df['24 m']
df['p36'] = -3 * df['36 m']
df['p48'] = -4 * df['48 m']
df['p60'] = -5 * df['60 m']
df['p72'] = -6 * df['72 m']
df['p84'] = -7 * df['84 m']
df['p96'] = -8 * df['96 m']
df['p108'] = -9 * df['108 m']
df['p120'] = -10 * df['120 m']

df['p12_next_year']= df['p12'].shift(-12)
df['p24_next_year']= df['p24'].shift(-12)
df['p36_next_year']= df['p36'].shift(-12)
df['p48_next_year']= df['p48'].shift(-12)
df['p60_next_year']= df['p60'].shift(-12)
df['p72_next_year']= df['p72'].shift(-12)
df['p84_next_year']= df['p84'].shift(-12)
df['p96_next_year']= df['p96'].shift(-12)
df['p108_next_year']= df['p108'].shift(-12)
df['p120_next_year']= df['p120'].shift(-12)

df['xr24'] = df['p12_next_year'] - df['p24'] - df['12 m']
df['xr36'] = df['p24_next_year'] - df['p36'] - df['12 m']
df['xr48'] = df['p36_next_year'] - df['p48'] - df['12 m']
df['xr60'] = df['p48_next_year'] - df['p60'] - df['12 m']
df['xr72'] = df['p60_next_year'] - df['p72'] - df['12 m']
df['xr84'] = df['p72_next_year'] - df['p84'] - df['12 m']
df['xr96'] = df['p84_next_year'] - df['p96'] - df['12 m']
df['xr108'] = df['p96_next_year'] - df['p108'] - df['12 m']
df['xr120'] = df['p108_next_year'] - df['p120'] - df['12 m']


df['0f1'] = df['12 m']
df['1f1'] = df['p12'] - df['p24']
df['2f1'] = df['p24'] - df['p36']
df['3f1'] = df['p36'] - df['p48']
df['4f1'] = df['p48'] - df['p60']
df['5f1'] = df['p60'] - df['p72']
df['6f1'] = df['p72'] - df['p84']
df['7f1'] = df['p84'] - df['p96']
df['8f1'] = df['p96'] - df['p108']
df['9f1'] = df['p108'] - df['p120']

fwd_cols = ['0f1', '1f1', '2f1', '3f1', '4f1', '5f1', '6f1', '7f1', '8f1', '9f1']
xr_cols = ['xr24', 'xr36', 'xr48', 'xr60', 'xr72', 'xr84', 'xr96', 'xr108', 'xr120']
data = df[["date"] + fwd_cols + xr_cols].copy()
data = data[(data["date"] >= 1971.08) & (data["date"] <= 2018.12)]

data.to_csv('./data_soo.csv', index=False)


##### PCA and Linear Regression #####
import numpy as np
import pandas as pd
from sklearn.decomposition import PCA
from sklearn.linear_model import LinearRegression, Ridge, Lasso, ElasticNet
from matplotlib import pyplot as plt


def r2_oos(y_true, y_pred, y_hist_mean):
    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()
    return 1 - (numerator/denominator)

df = pd.read_csv('../DATA/data_soo.csv')

# PCA(3), Linear
x_columns = ['0f1', '1f1', '2f1', '3f1', '4f1', '5f1', '6f1', '7f1', '8f1', '9f1']
y_columns = ['xr24', 'xr36', 'xr48', 'xr60', 'xr84', 'xr120']

df_sort = df.copy().sort_values("date")
dates = df_sort["date"]

pred_list =[]
true_list = []
date_list = []
history_mean_list = []
r2_score_list =[]

date_idx = df_sort[df_sort["date"] ==1989.01].index[0]

for y in y_columns:

    for t in dates.iloc[date_idx:]:
        train = df_sort[df_sort["date"] < t]
        test = df_sort[df_sort["date"] == t]

        x_train = train[x_columns]
        y_train = train[[y]]

        x_test = test[x_columns]
        y_test = test[[y]]
        y_train_hist_mean = np.mean(y_train)

        pca_model = PCA(n_components=3)
        pca_model.fit(x_train)
        x_train_pca = pca_model.transform(x_train)
        x_test_pca = pca_model.transform(x_test)

        # linear_model = LinearRegression()
        linear_model = Lasso(alpha=0.0001)
        linear_model.fit(x_train_pca, y_train)
        y_pred = linear_model.predict(x_test_pca)

        pred_list.append(y_pred[0])
        true_list.append(y_test[y].iloc[0])
        date_list.append(t)
        history_mean_list.append(y_train_hist_mean)

    df_out = pd.DataFrame({'date': date_list,
        'true': true_list,
        'predict': pred_list,
        'history_mean': history_mean_list})

    r2_score = r2_oos(df_out['true'], df_out['predict'], df_out['history_mean'])
    r2_score_list.append(r2_score)
print(r2_score_list)




##### Random Forest #####

import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from matplotlib import pyplot as plt

def r2_oos(y_true, y_pred, y_hist_mean):
    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()
    return 1 - (numerator/denominator)

df = pd.read_csv('../DATA/data_soo.csv')

# RF
x_columns = ['0f1', '1f1', '2f1', '3f1', '4f1', '5f1', '6f1', '7f1', '8f1', '9f1']
y_columns = ['xr24', 'xr36', 'xr48', 'xr60', 'xr84', 'xr120']

df_sort = df.copy().sort_values("date")
dates = df_sort["date"]

date_idx = df_sort[df_sort["date"] ==1989.01].index[0]

pred_list =[]
true_list =[]
date_list = []
history_mean_list = []
r2_score_list =[]

for y in y_columns:

    for t in dates.iloc[date_idx:]:
        train = df_sort[df_sort["date"] < t]
        test = df_sort[df_sort["date"] == t]

        x_train = train[x_columns]
        y_train = train[y]

        x_test = test[x_columns]
        y_test = test[y]
        y_train_hist_mean = np.mean(y_train)

        rf_model = RandomForestRegressor(random_state=0, n_estimators=20)
        rf_model.fit(x_train, y_train)
        y_pred = rf_model.predict(x_test)

        pred_list.append(y_pred[0])
        true_list.append(y_test.iloc[0])
        date_list.append(t)
        history_mean_list.append(y_train_hist_mean)

    df_out = pd.DataFrame({'date': date_list, 'prediction': pred_list, 'true': true_list, 'history_mean': history_mean_list})

    r2_score = r2_oos(df_out['true'], df_out['prediction'], df_out['history_mean'])
    r2_score_list.append(r2_score)
print(r2_score_list)



##### Neural Network #####
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from matplotlib import pyplot as plt
from tensorflow import keras
import gc


class Model:
    def __init__(self, x_dim, y_dim, h_dim, n_layers,
                 act='relu', l1=0.0, l2=1e-4, dropout=0.0, lr=1e-4,
                 epochs=1000, batch_size=32, patience=50):
        self.x_dim = x_dim
        self.y_dim = y_dim
        self.h_dim = h_dim
        self.n_layers = n_layers
        self.act = act
        self.l1 = l1
        self.l2 = l2
        self.dropout = dropout
        self.lr = lr
        self.epochs = epochs
        self.batch_size = batch_size
        self.patience = patience
        self.model = None

    def fit(self, x_train, y_train, x_val, y_val):
        self.model = self.build()
        self.model.compile(
            optimizer=keras.optimizers.legacy.SGD(learning_rate=self.lr, momentum=0.9, decay=0.01, nesterov=True),
            loss='mse'
        )
        self.model.fit(
            x_train,
            y_train,
            validation_data=(x_val, y_val),
            epochs=self.epochs,
            batch_size=self.batch_size,
            shuffle=False,
            verbose=1,
            callbacks=[
                keras.callbacks.EarlyStopping(
                    monitor='val_loss',
                    patience=self.patience,
                    restore_best_weights=True
                )
            ]
        )

    def build(self):
        input_layer = keras.layers.Input(shape=(self.x_dim,))
        hidden_layer = input_layer

        for _ in range(self.n_layers):
            hidden_layer = keras.layers.Dense(
                self.h_dim,
                activation=self.act,
                kernel_regularizer=keras.regularizers.L1L2(
                    l1=self.l1,
                    l2=self.l2
                ),
                bias_initializer='he_normal', kernel_initializer='he_normal'
            )(hidden_layer)

            if self.dropout > 0:
                hidden_layer = keras.layers.Dropout(self.dropout)(hidden_layer)

        output_layer = keras.layers.Dense(self.y_dim, activation='linear')(hidden_layer)
        return keras.Model(input_layer, output_layer)

    def predict(self, x_test):
        return self.model.predict(x_test, verbose=0)

    def reset(self):
        if self.model is not None:
            del self.model
            self.model = None
        keras.backend.clear_session()
        gc.collect()

def r2_oos(y_true, y_pred, y_hist_mean):
    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()
    return 1 - (numerator/denominator)

df = pd.read_csv('../DATA/data_soo.csv')

# RF
x_columns = ['0f1', '1f1', '2f1', '3f1', '4f1', '5f1', '6f1', '7f1', '8f1', '9f1']
y_columns = ['xr24', 'xr36', 'xr48', 'xr60', 'xr84', 'xr120']

df_sort = df.copy().sort_values("date")
dates = df_sort["date"]

date_idx = df_sort[df_sort["date"] ==1989.01].index[0]

pred_list =[]
true_list =[]
date_list = []
history_mean_list = []
r2_score_list =[]

for y in y_columns:

    for t in dates.iloc[date_idx:]:
        train = df_sort[df_sort["date"] < t]
        test = df_sort[df_sort["date"] == t]

        x_train = train[x_columns]
        num = int(len(x_train) * 0.85)
        y_train = train[y]

        x_train, x_val = x_train[:num], x_train[num:]
        y_train, y_val = y_train[:num], y_train[num:]

        x_test = test[x_columns]
        y_test = test[y]
        y_train_hist_mean = np.mean(y_train)

        nn_model = Model(x_dim=len(x_columns), y_dim=1, h_dim=3, n_layers=1,
                 act='relu', l1=0.01, l2= 0.01, dropout=0.1, lr=1e-2,
                 epochs=1, batch_size=32, patience=20)
        nn_model.fit(x_train, y_train, x_val, y_val)
        y_pred = nn_model.predict(x_test)

        pred_list.append(y_pred[0])
        true_list.append(y_test.iloc[0])
        date_list.append(t)
        history_mean_list.append(y_train_hist_mean)

    df_out = pd.DataFrame({'date': date_list, 'prediction': pred_list, 'true': true_list, 'history_mean': history_mean_list})

    r2_score = r2_oos(df_out['true'], df_out['prediction'], df_out['history_mean'])
    r2_score_list.append(r2_score)
print(r2_score_list)


##### RNN #####

from tensorflow import keras
import gc
import os
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler, MinMaxScaler


class RNNModel:
    def __init__(self, x_dim, y_dim, h_dim, n_layers, n_seq,
                 act='gelu', l1=0.0, l2=1e-4, dropout=0.0, lr=1e-4,
                 epochs=1000, batch_size=32, patience=50):
        self.x_dim = x_dim
        self.y_dim = y_dim
        self.h_dim = h_dim
        self.n_seq = n_seq
        self.n_layers = n_layers
        self.act = act
        self.l1 = l1
        self.l2 = l2
        self.dropout = dropout
        self.lr = lr
        self.epochs = epochs
        self.batch_size = batch_size
        self.patience = patience
        self.model = None

    def fit(self, x_train, y_train):
        self.model = self.build()
        self.model.compile(
            optimizer=keras.optimizers.Adam(learning_rate=self.lr),
            loss='mse'
        )
        self.model.fit(
            x_train,
            y_train,
            epochs=self.epochs,
            batch_size=self.batch_size,
            shuffle=False,
            verbose=0,
            callbacks=[
                keras.callbacks.EarlyStopping(
                    monitor='loss',
                    patience=self.patience,
                    restore_best_weights=True
                )
            ]
        )

    def build(self):
        input_layer = keras.layers.Input(shape=(self.n_seq, self.x_dim,))
        hidden_layer = input_layer

        for _ in range(self.n_layers):
            hidden_layer = keras.layers.LSTM(32, return_sequences=True)(hidden_layer)
            hidden_layer = keras.layers.LayerNormalization()(hidden_layer)
            if self.dropout > 0:
                hidden_layer = keras.layers.Dropout(self.dropout)(hidden_layer)
        rep_layer = keras.layers.LSTM(self.h_dim, return_sequences=False)(hidden_layer)
        rep_layer = keras.layers.LayerNormalization()(rep_layer)
        state_layer = keras.layers.Dense(1, activation='linear')(rep_layer)
        hidden_layer2 = keras.layers.Dense(self.h_dim, activation=self.act)(rep_layer)
        output_layer = keras.layers.Dense(self.y_dim, activation='linear')(hidden_layer2)
        return keras.Model(input_layer, [state_layer, output_layer])

    def predict(self, x_test):
        return self.model.predict(x_test, verbose=0)

    def reset(self):
        if self.model is not None:
            del self.model
            self.model = None
        keras.backend.clear_session()
        gc.collect()


def r2_oos(y_true, y_pred, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_pred = np.asarray(y_pred).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()

    if denominator == 0:
        return np.nan

    return 1 - numerator / denominator


def make_rnn_sequences(df, feature_cols, y_cols, lookback=12):
    x, y, target_dates = [], [], []

    values_x = df[feature_cols].values
    values_y = df[y_cols].values
    dates = df["date"].values

    for j in range(lookback, len(df)):
        x_seq = values_x[j - lookback:j]
        y_target = values_y[j]

        if np.isnan(x_seq).any() or np.isnan(y_target).any():
            continue

        x.append(x_seq)
        y.append(y_target)
        target_dates.append(dates[j])

    return np.array(x), np.array(y), np.array(target_dates)


def recursive_forecast(data, x_cols, y_cols, model, start_date=199001,
                       min_train_size=60, min_val_size=12):
    lookback = 12
    df = data.copy().sort_values('date').reset_index(drop=True)
    oos_idx = df.index[df['date'] >= start_date]

    df_outs = []
    for num_idx, i in enumerate(oos_idx):
        date = df['date'].iloc[i]
        print(y_cols, date, flush=True)
        train = df.iloc[:i].dropna(subset=x_cols + y_cols)
        test = df.iloc[[i]].dropna(subset=x_cols + y_cols)

        state_x_train, state_y_train = [], []
        for j in range(lookback, train.shape[0]):
            x_seq_train = train[x_cols].values[j - lookback:j]
            y_seq_train = train[x_cols].values[j]

            state_x_train.append(x_seq_train)
            state_y_train.append(y_seq_train)
        state_x_train = np.array(state_x_train)
        state_y_train = np.array(state_y_train)

        state_x_test = np.concatenate([state_x_train[-1:, 1:], state_y_train[-1:, np.newaxis, :]], axis=1)
        state_y_test = test[x_cols].values
        print(state_x_train.shape, state_y_train.shape, state_x_test.shape, state_y_test.shape)

        xr_y_train = train[y_cols].values[lookback:]
        xr_y_test = test[y_cols].values

        state_x_scalers = []
        xr_scaler = StandardScaler()
        for i in range(lookback):
            state_scaler = MinMaxScaler()
            state_x_train[:, i, :] = state_scaler.fit_transform(state_x_train[:, i, :])
            state_x_test[:, i, :] = state_scaler.transform(state_x_test[:, i, :])
            state_x_scalers.append(state_scaler)
        xr_y_train = xr_scaler.fit_transform(xr_y_train)

        model.fit(state_x_train, [state_y_train, xr_y_train])
        pred_state, pred_xr = model.predict(state_x_test)
        print(pred_xr.shape)
        pred_xr = xr_scaler.inverse_transform(pred_xr)

        model.reset()
        hist_mean = np.mean(train[y_cols].values, axis=0, keepdims=True)
        df_out = pd.DataFrame(columns=['date'] + [f'y_true_{y_col}' for y_col in y_cols]
                                      + [f'y_pred_{y_col}' for y_col in y_cols]
                                      + [f'hist_mean_{y_col}' for y_col in y_cols], index=range(1))

        df_out['date'] = date
        df_out[[f'y_true_{y_col}' for y_col in y_cols]] = xr_y_test
        df_out[[f'y_pred_{y_col}' for y_col in y_cols]] = pred_xr
        df_out[[f'hist_mean_{y_col}' for y_col in y_cols]] = hist_mean

        df_out.to_csv(f'./TEMP/out_{date}.csv', index=False)
        df_outs.append(df_out)

    df_outs = pd.concat(df_outs, axis=0, ignore_index=True)

    return df_outs


def plot_time_series(df, model_name, y_col):
    x_date = pd.to_datetime(df['date'].astype(str), format='%Y%m')

    plt.figure(figsize=(10, 4))
    plt.plot(x_date, df[f'y_true_{y_col}'].values, 'k', label='True')
    plt.plot(x_date, df[f'y_pred_{y_col}'].values, 'r', label='Pred')
    plt.plot(x_date, df[f'hist_mean_{y_col}'].values, 'b', label='Hist Mean')

    ax = plt.gca()
    ax.xaxis.set_major_locator(mdates.MonthLocator(interval=6))
    ax.xaxis.set_major_formatter(mdates.DateFormatter('%Y-%m'))

    plt.xticks(rotation=90)
    plt.ylabel(f'{y_col}')
    plt.legend(loc='best')
    plt.tight_layout()
    plt.savefig(f'./PLOT/{model_name}_xr_{y_col}.png')
    plt.close()


def plot_prediction_scatter(df, model_name, y_col):
    vmin = min(df[f'y_true_{y_col}'].min(), df[f'y_pred_{y_col}'].min())
    vmax = max(df[f'y_true_{y_col}'].max(), df[f'y_pred_{y_col}'].max())

    plt.figure(figsize=(5, 5))
    plt.plot(df[f'y_true_{y_col}'].values, df[f'y_pred_{y_col}'].values, 'ko')
    plt.plot([vmin, vmax], [vmin, vmax], 'k')

    plt.xlim(vmin * 1.1, vmax * 1.1)
    plt.ylim(vmin * 1.1, vmax * 1.1)

    plt.xlabel('y_true')
    plt.ylabel('y_pred')
    plt.tight_layout()
    plt.savefig(f'./PLOT/{model_name}_r2_{y_col}.png')
    plt.close()


if __name__ == '__main__':
    os.makedirs('./OUT', exist_ok=True)

    target_years = np.array([2, 3, 4, 5, 7, 10])
    y_cols = [f'xr{val}' for val in target_years]
    # target_years = np.array([10])
    fwd_cols = [f'f{i}' for i in range(1, 11)]

    data = pd.read_csv('../DATA/data.csv')
    # data = data[data['date'] < 199006].reset_index(drop=True)

    h_dim, n_layers = 64, 2
    model_name = f'RNN_{h_dim}_{n_layers}'

    results = []

    model = RNNModel(
        x_dim=len(fwd_cols),
        y_dim=len(y_cols),
        h_dim=h_dim,
        n_seq=12,
        n_layers=n_layers,
        act='gelu',
        dropout=0.0,
        lr=1e-4,
        epochs=1000,
        batch_size=32,
        patience=100
    )

    df = recursive_forecast(
        data,
        fwd_cols,
        y_cols,
        model,
        start_date=200001, # 199001
        min_train_size=60,
        min_val_size=12
    )
    score_list = []
    for y_col in y_cols:
        score = r2_oos(df[f'y_true_{y_col}'], df[f'y_pred_{y_col}'], df[f'hist_mean_{y_col}'])
        print(score)
        plot_time_series(df, model_name, y_col)
        plot_prediction_scatter(df, model_name, y_col)
        score_list.append(score)
    df_out = pd.DataFrame(columns=[y_col for y_col in y_cols], data=[score_list])
    df_out.to_csv('./OUT/score.csv', index=False)
