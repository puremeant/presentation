def make_macro_current_train_samples(
    data,
    x_columns,
    macro_columns,
    y_columns,
    lookback
):
    """
    For target date t:

        Yield path input:
            x_{t-12}, ..., x_{t-1}

        Auxiliary state target:
            x_t

        Current macro input:
            m_t

        Return target:
            xr_t

    This model uses current macro m_t, not macro path.
    """

    data = data.sort_values("date").reset_index(drop=True)

    past_seq_list = []
    state_target_list = []
    macro_input_list = []
    y_target_list = []
    target_dates = []

    for current_idx in range(lookback, len(data)):

        past_start = current_idx - lookback
        past_end = current_idx

        past_seq = data.iloc[past_start:past_end][x_columns]
        state_target = data.iloc[current_idx][x_columns]
        macro_input = data.iloc[current_idx][macro_columns]
        y_target = data.iloc[current_idx][y_columns]

        if past_seq.isna().any().any():
            continue

        if state_target.isna().any():
            continue

        if macro_input.isna().any():
            continue

        if y_target.isna().any():
            continue

        past_seq_list.append(past_seq.values)
        state_target_list.append(state_target.values)
        macro_input_list.append(macro_input.values)
        y_target_list.append(y_target.values)
        target_dates.append(data.iloc[current_idx]["date"])

    X_past = np.array(past_seq_list)
    X_state_target = np.array(state_target_list)
    M = np.array(macro_input_list)
    Y = np.array(y_target_list)
    target_dates = np.array(target_dates)

    return X_past, X_state_target, M, Y, target_dates


def make_macro_current_test_sample(
    df_sort,
    test_index,
    x_columns,
    macro_columns,
    lookback
):
    """
    For forecast date t:

        Yield path input:
            x_{t-12}, ..., x_{t-1}

        Current macro input:
            m_t

        State target for diagnostics:
            x_t
    """

    past_start = test_index - lookback
    past_end = test_index

    if past_start < 0:
        raise ValueError("Not enough historical observations to construct test sequence.")

    X_past_test = df_sort.iloc[past_start:past_end][x_columns].values
    X_past_test = X_past_test.reshape(1, lookback, len(x_columns))

    M_test = df_sort.iloc[test_index][macro_columns].values
    M_test = M_test.reshape(1, len(macro_columns))

    X_state_test = df_sort.iloc[test_index][x_columns].values
    X_state_test = X_state_test.reshape(1, len(x_columns))

    return X_past_test, M_test, X_state_test


# ==================================================
# 7. Build current-macro f-net RNN
# ==================================================

def build_macro_current_fnet_rnn(
    lookback,
    x_dim,
    macro_dim,
    y_dim,
    n_layers,
    h_dim,
    path_branch_dim,
    macro_branch_dim,
    final_dense_dim,
    activation,
    learning_rate,
    seed
):
    """
    RNN current macro f-net model:

        x_{t-12:t-1} -> RNN encoder -> h_t

        h_t -> path branch -> z_h_t
        m_t -> macro branch -> z_m_t

        [z_h_t, z_m_t] -> forecast head -> xr_t

    Auxiliary state-transition head:
        h_t -> x_hat_t
    """

    set_seed(seed)

    # ------------------------------
    # Yield path input
    # ------------------------------
    past_input = keras.Input(
        shape=(lookback, x_dim),
        name="past_yield_curve_path"
    )

    hidden_layer = past_input

    for layer_id in range(max(n_layers - 1, 0)):
        hidden_layer = layers.LSTM(
            32,
            return_sequences=True,
            recurrent_initializer="orthogonal",
            name=f"lstm_sequence_{layer_id + 1}"
        )(hidden_layer)

        hidden_layer = layers.LayerNormalization(
            name=f"layer_norm_sequence_{layer_id + 1}"
        )(hidden_layer)

    # Final LSTM creates h_t
    rep_layer = layers.LSTM(
        h_dim,
        return_sequences=False,
        recurrent_initializer="orthogonal",
        name="path_representation_lstm"
    )(hidden_layer)

    rep_layer = layers.LayerNormalization(
        name="path_representation_norm"
    )(rep_layer)

    # ------------------------------
    # Current macro input
    # ------------------------------
    macro_input = keras.Input(
        shape=(macro_dim,),
        name="macro_information"
    )

    macro_norm = layers.LayerNormalization(
        name="macro_norm"
    )(macro_input)

    # ------------------------------
    # Auxiliary state-transition head
    # h_t -> x_hat_t
    # ------------------------------
    state_hidden = layers.Dense(
        final_dense_dim,
        activation=activation,
        name="state_transition_hidden"
    )(rep_layer)

    state_output = layers.Dense(
        x_dim,
        activation="linear",
        name="state_output"
    )(state_hidden)

    # ------------------------------
    # Path branch
    # h_t -> z_h_t
    # ------------------------------
    path_branch = layers.Dense(
        path_branch_dim,
        activation=activation,
        name="path_branch_hidden"
    )(rep_layer)

    path_branch = layers.LayerNormalization(
        name="path_branch_norm"
    )(path_branch)

    # ------------------------------
    # Macro branch
    # m_t -> z_m_t
    # ------------------------------
    macro_branch = layers.Dense(
        macro_branch_dim,
        activation=activation,
        name="macro_branch_hidden"
    )(macro_norm)

    macro_branch = layers.LayerNormalization(
        name="macro_branch_norm"
    )(macro_branch)

    # ------------------------------
    # Merge branches and forecast returns
    # ------------------------------
    merged = layers.Concatenate(
        name="merge_path_and_macro_branches"
    )([path_branch, macro_branch])

    merged = layers.Dropout(
        BRANCH_DROPOUT,
        name="dropout_after_branch_merge"
    )(merged)

    final_hidden = layers.Dense(
        final_dense_dim,
        activation=activation,
        name="final_forecast_hidden"
    )(merged)

    xr_output = layers.Dense(
        y_dim,
        activation="linear",
        name="xr_output"
    )(final_hidden)

    model = keras.Model(
        inputs=[past_input, macro_input],
        outputs=[state_output, xr_output],
        name="macro_current_fnet_state_transition_rnn"
    )

    optimizer = keras.optimizers.Adam(
        learning_rate=learning_rate
    )

    model.compile(
        optimizer=optimizer,
        loss={
            "state_output": "mse",
            "xr_output": "mse"
        },
        loss_weights={
            "state_output": STATE_LOSS_WEIGHT,
            "xr_output": XR_LOSS_WEIGHT
        }
    )

    return model


# ==================================================
# 8. Fit one RNN
# ==================================================

def fit_one_macro_current_fnet_rnn(
    X_past_train_scaled,
    X_state_train_scaled,
    M_train_scaled,
    Y_train_scaled,
    X_past_test_scaled,
    M_test_scaled,
    seed
):
    keras.backend.clear_session()

    model = build_macro_current_fnet_rnn(
        lookback=X_past_train_scaled.shape[1],
        x_dim=X_past_train_scaled.shape[2],
        macro_dim=M_train_scaled.shape[1],
        y_dim=Y_train_scaled.shape[1],
        n_layers=N_LAYERS,
        h_dim=H_DIM,
        path_branch_dim=PATH_BRANCH_DIM,
        macro_branch_dim=MACRO_BRANCH_DIM,
        final_dense_dim=FINAL_DENSE_DIM,
        activation=ACTIVATION,
        learning_rate=LEARNING_RATE,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor=EARLY_STOP_MONITOR,
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=0,
        mode="auto",
        restore_best_weights=True
    )

    history = model.fit(
        [X_past_train_scaled, M_train_scaled],
        {
            "state_output": X_state_train_scaled,
            "xr_output": Y_train_scaled
        },
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=VALIDATION_SPLIT,
        shuffle=False,
        verbose=0,
        callbacks=[early_stop]
    )

    if MODEL_SELECTION_MONITOR not in history.history:
        print("Available history keys:")
        print(list(history.history.keys()))
        raise KeyError(
            f"{MODEL_SELECTION_MONITOR} not found in history.history."
        )

    model_loss = min(history.history[MODEL_SELECTION_MONITOR])

    # Diagnostics only
    total_loss = min(history.history["loss"]) if "loss" in history.history else np.nan
    xr_loss = min(history.history["xr_output_loss"]) if "xr_output_loss" in history.history else np.nan
    state_loss = min(history.history["state_output_loss"]) if "state_output_loss" in history.history else np.nan

    if VALIDATION_SPLIT > 0:
        total_val_loss = min(history.history["val_loss"]) if "val_loss" in history.history else np.nan
        val_xr_loss = min(history.history["val_xr_output_loss"]) if "val_xr_output_loss" in history.history else np.nan
        val_state_loss = min(history.history["val_state_output_loss"]) if "val_state_output_loss" in history.history else np.nan
    else:
        total_val_loss = np.nan
        val_xr_loss = np.nan
        val_state_loss = np.nan

    pred_state_scaled, pred_xr_scaled = model.predict(
        [X_past_test_scaled, M_test_scaled],
        verbose=0
    )

    del model
    keras.backend.clear_session()
    gc.collect()

    return (
        pred_state_scaled,
        pred_xr_scaled,
        model_loss,
        total_loss,
        xr_loss,
        state_loss,
        total_val_loss,
        val_xr_loss,
        val_state_loss
    )


