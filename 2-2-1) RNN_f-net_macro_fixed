macro_columns = [
    c for c in macro_columns
    if pd.api.types.is_numeric_dtype(df_sort[c])
]

# Safety check
bad_macro_columns = [
    c for c in macro_columns
    if is_xr_column(c)
]

if len(bad_macro_columns) > 0:
    raise ValueError(f"Leakage risk: xr columns found in macro_columns: {bad_macro_columns}")

if len(macro_columns) == 0:
    raise ValueError("No macro columns found after excluding date, yield columns, and all xr columns.")

print("All xr columns excluded from macro input:")
