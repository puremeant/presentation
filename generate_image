import pandas as pd
import numpy as np

# ==================================================
# 1. Set result file paths
# ==================================================
# 파일에는 date, true_xr24, pred_xr24, hist_xr24 ... 컬럼이 있어야 함.

FILES = {
    # Yield-only
    "yield_static_nn_avg": "PATH_TO/yield_static_nn_avg_predictions_eval.csv",
    "yield_lagged_nn_avg": "PATH_TO/yield_lagged_nn_avg_predictions_eval.csv",
    "yield_rnn_avg": "PATH_TO/yield_rnn_avg_predictions_eval.csv",

    # Macro avg
    "macro_nn_all_avg": "PATH_TO/macro_nn_all_avg_predictions_eval.csv",
    "macro_nn_fnet_avg": "PATH_TO/macro_nn_fnet_avg_predictions_eval.csv",
    "macro_rnn_joint_avg": "PATH_TO/macro_rnn_joint_avg_predictions_eval.csv",

    # Macro single, optional
    "macro_rnn_all_single": "PATH_TO/macro_rnn_all_single_predictions_eval.csv",
    "macro_rnn_current_single": "PATH_TO/macro_rnn_current_single_predictions_eval.csv",
    "macro_rnn_path_single": "PATH_TO/macro_rnn_path_single_predictions_eval.csv",
    "macro_rnn_joint_single": "PATH_TO/macro_rnn_joint_single_predictions_eval.csv",
}

Y_COLS = ["xr24", "xr36", "xr48", "xr60", "xr84", "xr120"]
MATURITIES = [2, 3, 4, 5, 7, 10]


# ==================================================
# 2. R2 OOS function
# ==================================================

def r2_oos_from_prediction_file(path, y_cols=Y_COLS):
    df = pd.read_csv(path).sort_values("date").reset_index(drop=True)

    out = {}

    for y in y_cols:
        true_col = f"true_{y}"
        pred_col = f"pred_{y}"
        hist_col = f"hist_{y}"

        if true_col not in df.columns:
            raise ValueError(f"Missing column: {true_col}")
        if pred_col not in df.columns:
            raise ValueError(f"Missing column: {pred_col}")
        if hist_col not in df.columns:
            raise ValueError(f"Missing column: {hist_col}")

        y_true = df[true_col].to_numpy()
        y_pred = df[pred_col].to_numpy()
        y_hist = df[hist_col].to_numpy()

        sse_model = np.nansum((y_true - y_pred) ** 2)
        sse_hist = np.nansum((y_true - y_hist) ** 2)

        r2 = 1 - sse_model / sse_hist
        out[y] = 100 * r2

    return out


# ==================================================
# 3. Print clean numbers for plotting
# ==================================================

rows = []

for model_name, path in FILES.items():
    if path.startswith("PATH_TO"):
        continue

    r2_dict = r2_oos_from_prediction_file(path)

    row = {"model": model_name}
    for mat, y in zip(MATURITIES, Y_COLS):
        row[f"xr{mat}"] = r2_dict[y]

    rows.append(row)

result = pd.DataFrame(rows)

print("\n=== R2 OOS by maturity, percent ===")
print(result.to_csv(index=False, float_format="%.2f"))


# ==================================================
# 4. Optional: print LaTeX table rows
# ==================================================

print("\n=== LaTeX rows ===")
for _, row in result.iterrows():
    values = []
    for mat in MATURITIES:
        values.append(f"${row[f'xr{mat}']:.1f}\\%$")
    print(row["model"].replace("_", " ") + " & " + " & ".join(values) + r" \\")


