# ==================================================
# 3. Helper functions
# ==================================================

def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    keras.utils.set_random_seed(seed)


def r2_oos(y_true, y_pred, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_pred = np.asarray(y_pred).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    numerator = np.nansum((y_true - y_pred) ** 2)
    denominator = np.nansum((y_true - y_hist_mean) ** 2)

    if denominator == 0:
        return np.nan

    return 1 - numerator / denominator


def rsz_signif(y_true, y_forecast, y_hist_mean):
    y_true = np.asarray(y_true).ravel()
    y_forecast = np.asarray(y_forecast).ravel()
    y_hist_mean = np.asarray(y_hist_mean).ravel()

    f = (
        (y_true - y_hist_mean) ** 2
        - (y_true - y_forecast) ** 2
        + (y_hist_mean - y_forecast) ** 2
    )

    x = np.ones(len(f))

    model = sm.OLS(f, x, missing="drop", hasconst=True)
    results = model.fit(cov_type="HAC", cov_kwds={"maxlags": 12})

    t_value = np.asarray(results.tvalues).ravel()[0]

    return 1 - tstat.cdf(t_value, results.nobs - 1)


# ==================================================
# 4. Make lagged NN samples
# ==================================================

def make_lagged_train_samples(data, x_columns, y_columns, lookback, include_current_x=False):
    """
    Creates flat lagged input vectors.

    If include_current_x=False:
        input for target date t:
            [x_{t-12}, x_{t-11}, ..., x_{t-1}]
        shape:
            12 * 10 = 120

    If include_current_x=True:
        input for target date t:
            [x_t, x_{t-1}, ..., x_{t-11}]
        shape:
            12 * 10 = 120

    Target:
        xr_t
    """

    data = data.sort_values("date").reset_index(drop=True)

    X_list = []
    Y_list = []
    target_dates = []

    for current_idx in range(lookback, len(data)):

        if include_current_x:
            # x_t, x_{t-1}, ..., x_{t-11}
            lag_indices = list(range(current_idx, current_idx - lookback, -1))
        else:
            # x_{t-12}, ..., x_{t-1}
            lag_indices = list(range(current_idx - lookback, current_idx))

        x_block = data.iloc[lag_indices][x_columns]
        y_target = data.iloc[current_idx][y_columns]

        if x_block.isna().any().any():
            continue

        if y_target.isna().any():
            continue

        # Flatten 12 x 10 into 120-dimensional vector
        x_flat = x_block.values.reshape(-1)

        X_list.append(x_flat)
        Y_list.append(y_target.values)
        target_dates.append(data.iloc[current_idx]["date"])

    X = np.array(X_list)
    Y = np.array(Y_list)
    target_dates = np.array(target_dates)

    return X, Y, target_dates


def make_lagged_test_sample(df_sort, test_index, x_columns, lookback, include_current_x=False):
    """
    Builds one test input vector for forecast date t.
    """

    if include_current_x:
        lag_indices = list(range(test_index, test_index - lookback, -1))
    else:
        lag_indices = list(range(test_index - lookback, test_index))

    if min(lag_indices) < 0:
        raise ValueError("Not enough historical observations to construct lagged test input.")

    x_block = df_sort.iloc[lag_indices][x_columns]

    if x_block.isna().any().any():
        raise ValueError("Missing X values in lagged test input.")

    X_test = x_block.values.reshape(1, -1)

    return X_test


# ==================================================
# 5. Build Lagged NN
# ==================================================

def build_lagged_nn(input_dim, y_dim, hidden_nodes, n_hidden_layers, activation, learning_rate, seed):
    set_seed(seed)

    model = keras.Sequential(name="lagged_nn")

    model.add(layers.Input(shape=(input_dim,)))

    for layer_id in range(n_hidden_layers):
        model.add(
            layers.Dense(
                hidden_nodes,
                activation=activation,
                name=f"hidden_{layer_id + 1}"
            )
        )

    model.add(
        layers.Dense(
            y_dim,
            activation="linear",
            name="output"
        )
    )

    model.compile(
        optimizer=keras.optimizers.Adam(learning_rate=learning_rate),
        loss="mse"
    )

    return model


# ==================================================
# 6. Fit one model
# ==================================================

def fit_one_lagged_nn(X_train_scaled, Y_train_scaled, X_test_scaled, seed):
    keras.backend.clear_session()

    model = build_lagged_nn(
        input_dim=X_train_scaled.shape[1],
        y_dim=Y_train_scaled.shape[1],
        hidden_nodes=HIDDEN_NODES,
        n_hidden_layers=N_HIDDEN_LAYERS,
        activation=ACTIVATION,
        learning_rate=LEARNING_RATE,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor=EARLY_STOP_MONITOR,
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=0,
        mode="auto",
        restore_best_weights=True
    )

    history = model.fit(
        X_train_scaled,
        Y_train_scaled,
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=VALIDATION_SPLIT,
        shuffle=False,
        verbose=0,
        callbacks=[early_stop]
    )

    model_loss = min(history.history[EARLY_STOP_MONITOR])

    pred_scaled = model.predict(X_test_scaled, verbose=0)

    del model
    keras.backend.clear_session()
    gc.collect()

    return pred_scaled, model_loss


