# ==================================================
# 5. Helper functions
# ==================================================

def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    keras.utils.set_random_seed(seed)


def r2_oos(y_true, y_pred, y_hist_mean):
    numerator = ((y_true - y_pred) ** 2).sum()
    denominator = ((y_true - y_hist_mean) ** 2).sum()
    return 1 - (numerator / denominator)


def rsz_signif(y_true, y_forecast, y_hist_mean):
    f = (
        (y_true - y_hist_mean) ** 2
        - (y_true - y_forecast) ** 2
        + (y_hist_mean - y_forecast) ** 2
    )

    x = np.ones(np.shape(f))

    model = sm.OLS(f, x, missing='drop', hasconst=True)
    results = model.fit(cov_type='HAC', cov_kwds={'maxlags': 12})

    return 1 - tstat.cdf(results.tvalues[0], results.nobs - 1)


def scale_rnn_sequences(x_scaler, X_seq):
    """
    StandardScaler expects 2D input.
    RNN input is 3D: (n_samples, lookback, n_features).
    So we flatten temporarily and reshape back.
    """
    n_samples, lookback, n_features = X_seq.shape

    X_scaled = x_scaler.transform(
        X_seq.reshape(-1, n_features)
    ).reshape(n_samples, lookback, n_features)

    return X_scaled


# ==================================================
# 6. Make State-Transition RNN samples
# ==================================================

def make_transition_train_samples(data, x_columns, y_columns, lookback):
    """
    For target date t:

        input:
            x_{t-12}, ..., x_{t-1}

        auxiliary state target:
            x_t

        main return target:
            xr_t

    Model:
        h_t = Phi(x_{t-12}, ..., x_{t-1})
        x_hat_t = q(h_t)
        xr_hat_t = g(h_t)
    """

    data = data.sort_values("date").reset_index(drop=True)

    past_seq_list = []
    state_target_list = []
    y_target_list = []
    target_dates = []

    for current_idx in range(lookback, len(data)):

        past_start = current_idx - lookback
        past_end = current_idx

        past_seq = data.iloc[past_start:past_end][x_columns]
        state_target = data.iloc[current_idx][x_columns]
        y_target = data.iloc[current_idx][y_columns]

        if past_seq.isna().any().any():
            continue

        if state_target.isna().any():
            continue

        if y_target.isna().any():
            continue

        past_seq_list.append(past_seq.values)
        state_target_list.append(state_target.values)
        y_target_list.append(y_target.values)
        target_dates.append(data.iloc[current_idx]["date"])

    X_past = np.array(past_seq_list)
    X_state_target = np.array(state_target_list)
    Y = np.array(y_target_list)
    target_dates = np.array(target_dates)

    return X_past, X_state_target, Y, target_dates


def make_transition_test_sample(df_sort, test_index, x_columns, lookback):
    """
    For forecast date t:

        input:
            x_{t-12}, ..., x_{t-1}

        state target:
            x_t
    """

    past_start = test_index - lookback
    past_end = test_index

    if past_start < 0:
        raise ValueError("Not enough historical observations to construct test sequence.")

    X_past_test = df_sort.iloc[past_start:past_end][x_columns].values
    X_past_test = X_past_test.reshape(1, lookback, len(x_columns))

    X_state_test = df_sort.iloc[test_index][x_columns].values
    X_state_test = X_state_test.reshape(1, len(x_columns))

    return X_past_test, X_state_test


# ==================================================
# 7. Build State-Transition RNN
# ==================================================

def build_state_transition_rnn(
    lookback,
    x_dim,
    y_dim,
    n_layers,
    h_dim,
    dense_dim,
    activation,
    learning_rate,
    seed
):
    set_seed(seed)

    past_input = keras.Input(
        shape=(lookback, x_dim),
        name="past_yield_curve_path"
    )

    hidden_layer = past_input

    # If N_LAYERS=1, skip this loop and use only the final LSTM.
    # If N_LAYERS>1, stack sequence-returning LSTMs before final LSTM.
    for layer_id in range(max(n_layers - 1, 0)):
        hidden_layer = layers.LSTM(
            32,
            return_sequences=True,
            recurrent_initializer="orthogonal",
            name=f"lstm_sequence_{layer_id + 1}"
        )(hidden_layer)

        hidden_layer = layers.LayerNormalization(
            name=f"layer_norm_sequence_{layer_id + 1}"
        )(hidden_layer)

    # Final LSTM summarizes the past path into h_t
    rep_layer = layers.LSTM(
        h_dim,
        return_sequences=False,
        recurrent_initializer="orthogonal",
        name="path_representation_lstm"
    )(hidden_layer)

    rep_layer = layers.LayerNormalization(
        name="path_representation_norm"
    )(rep_layer)

    # --------------------------------------------------
    # Auxiliary task: predict current yield state x_t
    # Nonlinear state head:
    # h_t -> Dense(dense_dim, activation) -> x_hat_t
    # --------------------------------------------------
    state_hidden = layers.Dense(
        dense_dim,
        activation=activation,
        name="state_transition_hidden"
    )(rep_layer)

    state_output = layers.Dense(
        x_dim,
        activation="linear",
        name="state_output"
    )(state_hidden)

    # --------------------------------------------------
    # Main task: predict future excess returns xr_t
    # h_t -> Dense(dense_dim, activation) -> xr_hat_t
    # --------------------------------------------------
    xr_hidden = layers.Dense(
        dense_dim,
        activation=activation,
        name="xr_forecast_hidden"
    )(rep_layer)

    xr_output = layers.Dense(
        y_dim,
        activation="linear",
        name="xr_output"
    )(xr_hidden)

    model = keras.Model(
        inputs=[past_input],
        outputs=[state_output, xr_output],
        name="state_transition_rnn"
    )

    optimizer = keras.optimizers.Adam(
        learning_rate=learning_rate
    )

    model.compile(
        optimizer=optimizer,
        loss={
            "state_output": "mse",
            "xr_output": "mse"
        },
        loss_weights={
            "state_output": STATE_LOSS_WEIGHT,
            "xr_output": XR_LOSS_WEIGHT
        }
    )

    return model


# ==================================================
# 8. Fit one State-Transition RNN
# ==================================================

def fit_one_transition_rnn(
    X_past_train_scaled,
    X_state_train_scaled,
    Y_train_scaled,
    X_past_test_scaled,
    seed
):
    keras.backend.clear_session()

    model = build_state_transition_rnn(
        lookback=X_past_train_scaled.shape[1],
        x_dim=X_past_train_scaled.shape[2],
        y_dim=Y_train_scaled.shape[1],
        n_layers=N_LAYERS,
        h_dim=H_DIM,
        dense_dim=DENSE_DIM,
        activation=ACTIVATION,
        learning_rate=LEARNING_RATE,
        seed=seed
    )

    early_stop = keras.callbacks.EarlyStopping(
        monitor=EARLY_STOP_MONITOR,
        min_delta=1e-6,
        patience=PATIENCE,
        verbose=0,
        mode='auto',
        restore_best_weights=True
    )

    history = model.fit(
        X_past_train_scaled,
        {
            "state_output": X_state_train_scaled,
            "xr_output": Y_train_scaled
        },
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_split=VALIDATION_SPLIT,
        shuffle=False,
        verbose=0,
        callbacks=[early_stop]
    )

    model_loss = min(history.history[EARLY_STOP_MONITOR])

    pred_state_scaled, pred_xr_scaled = model.predict(
        X_past_test_scaled,
        verbose=0
    )

    del model
    keras.backend.clear_session()
    gc.collect()

    return pred_state_scaled, pred_xr_scaled, model_loss


